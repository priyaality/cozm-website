---
/**
 * AboutIntro — the about page's opening screen (Figma 226:2464). 7/5 split:
 * the headline and its one-line follow-up on the left, the manifesto copy
 * signed by Palash on the right. At least one viewport tall (it grows rather
 * than clipping on short screens), content centred below the fixed header.
 */
import { aboutIntro } from '../../data/site';

const { heading, subheading, body, signature } = aboutIntro;
---

<section
  class="grid-split items-center gap-y-12 bg-sand px-gutter pt-[calc(var(--spacing-nav)+2rem)] pb-8 lg:min-h-svh"
>
  <div class="flex flex-col gap-4">
    <h1 class="text-display-sm">{heading}</h1>
    <p class="text-body leading-[1.3]">{subheading}</p>
  </div>

  <div class="flex flex-col gap-6">
    {body.map((paragraph) => <p class="text-body leading-[1.3]">{paragraph}</p>)}
    <p class="font-signature text-[1.5rem] leading-none tracking-[-0.02em]">{signature}</p>
  </div>
</section>
