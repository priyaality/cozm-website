---
/**
 * AboutIntro — the about page's opening screen (Figma 241:2761): the
 * full-width headline and its one-line follow-up, centred in a section 90%
 * of the screen tall, header included (it grows rather than clipping on short
 * screens).
 */
import { aboutIntro } from '../../data/site';

const { heading, subheading } = aboutIntro;
---

<section
  class="flex flex-col justify-center gap-4 bg-sand px-gutter pt-[calc(var(--spacing-nav)+2rem)] pb-8 lg:min-h-[90svh]"
>
  <h1 class="text-display">{heading}</h1>
  <p class="text-body leading-[1.3]">{subheading}</p>
</section>
