---
/**
 * Manifesto — why COZM exists (Figma 241:2765). The copy fills the first 7
 * grid columns; a white frame (ink rule on its left) fills the last 5 and runs
 * out to the right edge of the screen, the full height of the section. On desktop the section
 * fills the visible area below the header, with the copy centred vertically.
 */
import { manifesto } from '../../data/site';
---

<section
  data-tone="red"
  class="grid-split gap-y-8 border-t border-black bg-brick-red px-gutter text-butter lg:min-h-[calc(100svh-var(--spacing-nav))]"
>
  <div class="flex flex-col justify-center gap-6 py-8">
    {manifesto.body.map((paragraph) => <p class="text-lead">{paragraph}</p>)}
  </div>

  <!-- White frame (placeholder for a visual). -mr-gutter: bleeds into the right page margin. -->
  <div aria-hidden="true" class="-mx-gutter aspect-[4/5] border-black bg-paper max-lg:border-y lg:mx-0 lg:-mr-gutter lg:aspect-auto lg:border-l"></div>
</section>
