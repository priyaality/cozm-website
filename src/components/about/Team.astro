---
/**
 * Team — Palash's bio (Figma 241:2721). 7/5 split: "TEAM" label, the bio in
 * large body type with an inline link, and X / LinkedIn / Substack links on
 * the left (vertically centred); his photo fills the right column, framed in
 * ink. On desktop it fills the visible area below the header.
 */
import { Image } from 'astro:assets';
import { team } from '../../data/site';
import { withBase } from '../../lib/paths';
import photo from '../../assets/about/palash.png';
import xIcon from '../../assets/icons/x.svg';
import linkedinIcon from '../../assets/icons/linkedin.svg';
import substackIcon from '../../assets/icons/substack.svg';

const social = [
  { label: `${team.name} on X`, href: team.social.x, Icon: xIcon },
  { label: `${team.name} on LinkedIn`, href: team.social.linkedin, Icon: linkedinIcon },
  { label: `${team.name} on Substack`, href: team.social.substack, Icon: substackIcon },
];
---

<section
  data-tone="red"
  class="grid-split gap-y-10 border-t border-black bg-brick-red px-gutter text-butter py-8 lg:min-h-[calc(100svh-var(--spacing-nav))]"
>
  <div class="flex flex-col justify-center gap-4">
    <h2 class="text-caption leading-[1.2] font-semibold text-black uppercase">Team</h2>
    <div class="flex flex-col gap-6 text-lead">
      {
        team.bio.map((paragraph) => (
          <p>
            {typeof paragraph === 'string'
              ? paragraph
              : paragraph.map((part) =>
                  typeof part === 'string' ? (
                    part
                  ) : (
                    <a href={withBase(part.href)} class="text-black underline-offset-4 hover:underline focus-visible:underline">
                      {part.label}
                    </a>
                  ),
                )}
          </p>
        ))
      }
    </div>
    <ul class="flex gap-2">
      {
        social.map(({ label, href, Icon }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener"
              aria-label={`${label} (opens in a new tab)`}
              class="grid size-8 place-items-center transition-opacity hover:opacity-60"
            >
              <Icon width={Icon.width} height={Icon.height} aria-hidden="true" focusable="false" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="relative aspect-[554/613] overflow-hidden border border-black lg:aspect-auto">
    <Image
      src={photo}
      alt={team.name}
      class="absolute inset-0 size-full object-cover"
      widths={[400]}
      sizes="(min-width: 64rem) 37vw, 100vw"
    />
  </div>
</section>
