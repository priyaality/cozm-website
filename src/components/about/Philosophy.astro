---
/**
 * Philosophy — "Our philosophy" (Figma 241:2699). The four principles fill a
 * ruled 2 × 2 grid on the left, running from the left edge of the screen to
 * just past column 7; the heading sits to its right. On desktop the section
 * fills the visible area below the header and the cells stretch to share it.
 * In each cell the icon (a white square placeholder for now) is at the top
 * and the title and description at the bottom. Below lg the
 * heading comes first and the principles stack with rules between.
 */
import { philosophy } from '../../data/site';
---

<!--
  --col: one of the 12 page-grid columns (the section has no side padding, so
  the gutters are subtracted here). The grid is gutter + 7 columns + 7 gaps wide.
-->
<section
  class="flex flex-col border-t border-ink bg-sand [--col:calc((100%-2*var(--spacing-gutter)-11*var(--spacing-column-gap))/12)] lg:min-h-[calc(100svh-var(--spacing-nav))] lg:flex-row"
>
  <div
    class="flex flex-col border-ink lg:w-[calc(var(--spacing-gutter)+7*var(--col)+7*var(--spacing-column-gap))] lg:shrink-0 lg:border-r"
  >
    {
      [philosophy.slice(0, 2), philosophy.slice(2, 4)].map((row, r) => (
        <div class:list={['flex flex-1 flex-col sm:flex-row', r === 0 && 'border-b border-ink']}>
          {row.map((item, c) => (
            <div
              class:list={[
                'flex flex-1 flex-col justify-between gap-6 px-gutter',
                r === 0 ? 'pt-8 pb-4' : 'pt-4 pb-8',
                c === 0 ? 'border-ink max-sm:border-b sm:border-r sm:pr-4' : 'sm:pl-4',
                c === 1 && 'lg:pr-4',
              ]}
            >
              <div aria-hidden="true" class="size-[124px] bg-paper" />
              <div class="flex flex-col gap-2">
                <h3 class="text-title leading-none font-medium">{item.title}</h3>
                <p class="text-body">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <div class="px-gutter py-8 max-lg:order-first max-lg:border-b max-lg:border-ink lg:flex-1 lg:pl-4">
    <h2 class="text-headline">Our philosophy</h2>
  </div>
</section>
