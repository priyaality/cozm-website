---
/**
 * Philosophy — "Our philosophy" (Figma 241:2699). The four principles fill a
 * ruled 2 × 2 grid on the left, running from the left edge of the screen to
 * just past column 7; the heading sits to its right. On desktop the section
 * fills the visible area below the header and the cells stretch to share it.
 * In each cell the icon (a white square placeholder for now) is at the top
 * and the title and description at the bottom. Below lg the
 * heading comes first and the principles stack with rules between.
 */
import { philosophy } from '../../data/site';
---

<!--
  Same 12-column 7 + 5 grid as the manifesto above (grid-split), so the
  vertical rule — the heading column's left border in both sections — is laid
  out identically and lines up at every width. The principles' grid extends
  into the left page margin (-ml-gutter) and across the column gap (-mr-gap),
  so it meets the heading column exactly.
-->
<section
  aria-labelledby="philosophy-heading"
  data-tone="red"
  class="grid grid-cols-1 gap-x-column-gap border-t border-black bg-brick-red px-gutter text-butter lg:grid-12 lg:min-h-[calc(100svh-var(--spacing-nav))]"
>
  <!-- Heading first in reading order; on desktop it's placed in the right-hand 5 columns. -->
  <div class="border-black py-8 max-lg:-mx-gutter max-lg:border-b max-lg:px-gutter lg:order-last lg:col-span-5 lg:border-l lg:pl-4">
    <h2 id="philosophy-heading" class="text-headline">Our philosophy</h2>
  </div>

  <div class="-mx-gutter flex flex-col lg:col-span-7 lg:mr-[calc(-1*var(--spacing-column-gap))]">
    {
      [philosophy.slice(0, 2), philosophy.slice(2, 4)].map((row, r) => (
        <div class:list={['flex flex-1 flex-col sm:flex-row', r === 0 && 'border-b border-black']}>
          {row.map((item, c) => (
            <div
              class:list={[
                'flex flex-1 flex-col justify-between gap-6 px-gutter',
                r === 0 ? 'pt-8 pb-4' : 'pt-4 pb-8',
                c === 0 ? 'border-black max-sm:border-b sm:border-r sm:pr-4' : 'sm:pl-4',
                c === 1 && 'lg:pr-4',
              ]}
            >
              <div aria-hidden="true" class="size-[124px] bg-paper" />
              <div class="flex flex-col gap-2">
                <h3 class="text-title leading-none">{item.title}</h3>
                <p class="text-body">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>
