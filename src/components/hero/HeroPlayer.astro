---
/**
 * HeroPlayer — full-viewport hero whose intro doubles as the site's loading
 * animation. Scrolling is locked until it finishes:
 *
 *   1. A music-player card fades in. Its thumbnail is the hero video, paused.
 *   2. The card scales up around the thumbnail until the thumbnail covers the
 *      viewport (the frame and controls move off-screen and fade out).
 *   3. The video plays (muted, looping).
 *   4. The "now playing" card (bottom-left) and the site header fade in.
 *   5. The scroll-down button (bottom-right) fades in, then scrolling unlocks.
 *
 * State lives on <html>: `.hero-header-in` shows the header, `.hero-intro-done`
 * unlocks scrolling. A failsafe unlocks everything after 10s if the sequence
 * fails. The video is the same element throughout, so there's no jump when it
 * starts. With prefers-reduced-motion, or when the URL has a #hash (a deep
 * link), the intro is skipped. Without JS the card is shown unexpanded and the
 * page scrolls normally (the video only preloads metadata; the script asks for
 * the rest).
 */
import PlayerCard from './PlayerCard.astro';
import NowPlaying from './NowPlaying.astro';
import Button from '../ui/Button.astro';

interface VideoSource {
  src: string;
  type: string;
}

interface Props {
  /** Encodings of the same video, best first; the browser plays the first it supports. */
  sources?: VideoSource[];
  poster?: string;
  /** Seconds into the video to show first and start playing from (media fragment #t=). */
  startAt?: number;
  title: string;
  subtitle: string;
  /** Fallback total time for the player card; replaced by the video's real duration. */
  duration: string;
  /** Element id the scroll-down button scrolls to. */
  next: string;
}

const { sources = [], poster, startAt, title, subtitle, duration, next } = Astro.props;
const withStart = (src: string) => (startAt ? `${src}#t=${startAt}` : src);
---

<!-- Sand while the player card loads; the video covers it once expanded. -->
<div data-hero data-hero-player class="relative h-svh overflow-hidden bg-sand">
  <div class="absolute inset-0 grid place-items-center">
    <PlayerCard title={title} subtitle={subtitle} duration={duration}>
      {
        sources.length > 0 && (
          <video
            data-hero-video
            class="absolute inset-0 size-full object-cover"
            muted
            loop
            playsinline
            preload="metadata"
            poster={poster}
            disablepictureinpicture
            aria-hidden="true"
          >
            {sources.map((s) => (
              <source src={withStart(s.src)} type={s.type} />
            ))}
          </video>
        )
      }
    </PlayerCard>
  </div>

  <div class="hero-reveal absolute bottom-6 left-gutter max-w-[calc(100%-2*var(--spacing-gutter)-4.5rem)] sm:max-w-sm">
    <NowPlaying title={title} subtitle={subtitle} poster={poster} />
  </div>

  <Button
    href={`#${next}`}
    variant="secondary"
    size="icon"
    data-scroll-cue
    aria-label="Scroll to content"
    class="hero-reveal absolute right-gutter bottom-6"
  >
    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
      ><path d="M12 4v16M5 13l7 7 7-7"></path></svg
    >
  </Button>
</div>

<style is:global>
  /* Global: these target elements rendered by child components. */
  /* Hidden until the intro reveals them (only when JS is running). */
  html.js [data-hero-player] [data-player-card] {
    opacity: 0;
  }
  /* visibility too, so the hidden controls can't be tabbed to or clicked during the intro. */
  html.js [data-hero-player] .hero-reveal {
    opacity: 0;
    visibility: hidden;
  }

  /* Loading-animation scroll lock, lifted when the intro adds .hero-intro-done. */
  html.js:not(.hero-intro-done):has([data-hero-player]) {
    overflow: hidden;
  }
  /* Without JS the video never plays, so the "now playing" card is meaningless. */
  html:not(.js) [data-hero-player] [data-now-playing] {
    display: none;
  }

  /* Site header: hidden during the intro, fades in with the "now playing" card. */
  html.js body:has([data-hero-player]) #site-header {
    transition-property: color, background-color, border-color, opacity, visibility;
    transition-duration: 300ms, 300ms, 300ms, 600ms, 600ms;
  }
  html.js:not(.hero-header-in) body:has([data-hero-player]) #site-header {
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  // Web Animations API, no library. The easings are the cubic-béziers the intro
  // was designed with in Motion.
  const EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const EASE_IN_OUT = 'cubic-bezier(0.76, 0, 0.24, 1)';
  const EASE_OUT_PLAIN = 'cubic-bezier(0, 0, 0.58, 1)'; // Motion's 'easeOut'
  const MIN_LOADING_MS = 1000; // from the card starting to appear (includes its 0.8s fade-in)
  const MAX_LOADING_MS = 5000;
  const FAILSAFE_MS = 10000;

  const hero = document.querySelector<HTMLElement>('[data-hero-player]');
  if (hero) setUpHero(hero);

  function setUpHero(hero: HTMLElement) {
    const root = document.documentElement;
    const card = hero.querySelector<HTMLElement>('[data-player-card]');
    const thumb = hero.querySelector<HTMLElement>('[data-player-thumb]');
    const chrome = hero.querySelector<HTMLElement>('[data-player-chrome]');
    const cue = hero.querySelector<HTMLAnchorElement>('[data-scroll-cue]');
    const nowPlaying = hero.querySelector<HTMLElement>('[data-now-playing]');
    const nowPlayingWrap = nowPlaying?.closest<HTMLElement>('.hero-reveal');
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
    const durationLabel = hero.querySelector('[data-player-duration]');
    const toggle = hero.querySelector<HTMLButtonElement>('[data-now-playing-toggle]');

    // Markup out of sync with this script: never leave the page hidden or locked.
    if (!card || !thumb || !chrome || !cue || !nowPlaying || !nowPlayingWrap) {
      if (card) card.style.opacity = '1';
      root.classList.add('hero-header-in', 'hero-intro-done');
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // A deep link (e.g. /#main-content) should land on its section, not sit through the intro.
    const skipIntro = reducedMotion || location.hash.length > 1;
    const isDone = () => root.classList.contains('hero-intro-done');

    // The markup only preloads metadata so the video doesn't compete with the
    // page's own CSS, fonts and JS; buffer it now that the intro needs it.
    if (video) video.preload = 'auto';

    // Everything after the hero (main, footer…). Made inert during the intro so
    // Tab can't focus into it, because focusing an element would scroll the page
    // even while scrolling is locked.
    const belowHero = [...document.body.children].filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el !== hero && el.id !== 'site-header',
    );
    const unlock = () => {
      belowHero.forEach((el) => (el.inert = false));
      root.classList.add('hero-intro-done');
    };
    if (!skipIntro) belowHero.forEach((el) => (el.inert = true));

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, Math.max(0, ms)));

    /** Resolves once the video has enough data to play (or fails to load, so we never hang). */
    const videoReady = () =>
      new Promise<void>((resolve) => {
        if (
          !video ||
          video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA ||
          video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE
        )
          return resolve();
        const listeners = new AbortController();
        const ready = () => {
          listeners.abort();
          resolve();
        };
        const opts = { signal: listeners.signal };
        video.addEventListener('canplay', ready, opts);
        video.addEventListener('error', ready, opts);
        // With <source> children, a failed load fires 'error' on the last <source>, not the video.
        video.querySelector('source:last-of-type')?.addEventListener('error', ready, opts);
      });

    // Show the video's real length on the player card.
    const showDuration = () => {
      if (!video || !durationLabel || !Number.isFinite(video.duration)) return;
      const total = Math.round(video.duration);
      durationLabel.textContent = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    };
    if (video?.readyState) showDuration();
    video?.addEventListener('loadedmetadata', showDuration);
    let expanded = false;

    /** Transform that scales the card about the thumbnail's centre until the thumbnail covers the hero. */
    const coverTransform = () => {
      // offset* values ignore transforms, so this measures the card's resting layout.
      // thumb.offset* are measured from inside the card's border; transform-origin and
      // card.offset* use its border box, so add the border width (clientLeft/Top).
      const cx = card.clientLeft + thumb.offsetLeft + thumb.offsetWidth / 2;
      const cy = card.clientTop + thumb.offsetTop + thumb.offsetHeight / 2;
      const scale =
        Math.max(hero.clientWidth / thumb.offsetWidth, hero.clientHeight / thumb.offsetHeight) * 1.002;
      const x = hero.clientWidth / 2 - (card.offsetLeft + cx);
      const y = hero.clientHeight / 2 - (card.offsetTop + cy);
      return { origin: `${cx}px ${cy}px`, transform: `translateX(${x}px) translateY(${y}px) scale(${scale})` };
    };

    const applyCover = () => {
      const t = coverTransform();
      card.style.transformOrigin = t.origin;
      card.style.transform = t.transform;
    };

    const play = () => {
      if (!video) return;
      video.muted = true;
      video.play().catch(() => {});
    };

    const toggleLabel = toggle?.querySelector('[data-now-playing-label]');
    const pauseIcon = toggle?.querySelector('[data-icon-pause]');
    const playIcon = toggle?.querySelector('[data-icon-play]');
    const syncToggle = () => {
      const paused = !video || video.paused;
      if (toggleLabel) toggleLabel.textContent = paused ? 'Play' : 'Pause';
      pauseIcon?.classList.toggle('hidden', paused);
      playIcon?.classList.toggle('hidden', !paused);
      nowPlaying.toggleAttribute('data-paused', paused);
    };

    /** Intro animations still running, so the failsafe can stop them. */
    const running = new Set<Animation>();

    /**
     * Animates el's inline style from `from` to `to`. `to` is set inline first, so it
     * stays once the animation ends. Rejects if the animation is cancelled.
     */
    const tween = async (el: HTMLElement, from: Keyframe, to: Keyframe, ms: number, easing: string) => {
      Object.assign(el.style, to);
      const animation = el.animate([from, to], { duration: ms, easing });
      running.add(animation);
      try {
        await animation.finished;
      } finally {
        running.delete(animation);
      }
    };

    const fadeUp = (el: HTMLElement, ms: number) => {
      el.style.visibility = 'visible';
      const from = { opacity: '0', transform: 'translateY(16px)' };
      return tween(el, from, { opacity: '1', transform: 'none' }, ms, EASE_OUT);
    };

    /** Jump to the end state: expanded, playing, everything visible, scrolling unlocked. */
    const showAll = () => {
      running.forEach((animation) => animation.cancel());
      expanded = true;
      applyCover();
      card.style.opacity = '1';
      chrome.style.opacity = '0';
      [nowPlayingWrap, cue].forEach((el) => {
        el.style.visibility = 'visible';
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      play();
      root.classList.add('hero-header-in');
      unlock();
    };

    const intro = async () => {
      if (skipIntro) {
        showAll();
        return;
      }

      // Always run the intro from the top of the page.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      // 1. Fade the player in. It sits in its loading state (spinner, 0:00) until
      //    the video can actually play: at least MIN_LOADING_MS, at most MAX_LOADING_MS.
      const shownAt = performance.now();
      const hidden = { opacity: '0', transform: 'translateY(24px)' };
      await tween(card, hidden, { opacity: '1', transform: 'none' }, 800, EASE_OUT);
      await Promise.race([videoReady(), wait(MAX_LOADING_MS)]);
      await wait(MIN_LOADING_MS - (performance.now() - shownAt));
      if (isDone()) return; // the failsafe already showed everything

      // 2. Expand: scale the card about the thumbnail until it covers the viewport.
      const t = coverTransform();
      card.style.transformOrigin = t.origin;
      void tween(chrome, { opacity: '1' }, { opacity: '0' }, 400, EASE_OUT_PLAIN).catch(() => {});
      const rest = { transform: 'translateX(0px) translateY(0px) scale(1)' };
      await tween(card, rest, { transform: t.transform }, 1200, EASE_IN_OUT);
      expanded = true;

      // 3. Play.
      play();

      // 4. "Now playing" card + header together (the header fades via CSS, 600ms).
      root.classList.add('hero-header-in');
      await fadeUp(nowPlayingWrap, 600);

      // 5. Scroll-down button, then unlock scrolling.
      await fadeUp(cue, 500);
      unlock();
    };

    toggle?.addEventListener('click', () => {
      if (!video) return;
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    });
    video?.addEventListener('play', syncToggle);
    video?.addEventListener('pause', syncToggle);
    syncToggle();

    cue.addEventListener('click', (event) => {
      const target = document.getElementById(cue.hash.slice(1));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth' });
    });

    // Keep the expanded video covering the viewport when it resizes.
    window.addEventListener('resize', () => {
      if (expanded) applyCover();
    });

    // Never leave the page locked: if the intro errors or stalls, jump to the end state.
    const failsafe = window.setTimeout(showAll, FAILSAFE_MS);
    intro()
      .catch(showAll)
      .finally(() => window.clearTimeout(failsafe));
  }
</script>
