---
/**
 * OriginalsShowcase — the /originals page's opening screen (Figma 201:1262,
 * second state 201:1637).
 *
 * One viewport tall, over the selected original's background video (muted,
 * looping, inline, from its start time, like the home hero). The header sits
 * transparent over it ([data-hero]), the heading is at the top, and along the
 * bottom are the originals list (ProjectList, left) and the selected
 * original's details (ProjectDetails, right, 5 columns) — the same components
 * as /work. A light gradient at the top and bottom keeps the sand text
 * readable whatever the video shows.
 *
 * Selecting another original crossfades its details and fades the video to
 * black, switches to that original's video (or restarts it from its start
 * time if it's the same file), then fades back in. A coming-soon original gets
 * a "Coming soon!" tag and the notify form instead of links.
 */
import ProjectList from '../ui/ProjectList.astro';
import ProjectDetails from '../ui/ProjectDetails.astro';
import NotifyForm from '../ui/NotifyForm.astro';
import type { Original } from '../../data/site';

interface Props {
  heading: string;
  items: Original[];
}

const { heading, items } = Astro.props;
const withStart = (v: Original['video']) => (v.startAt ? `${v.src}#t=${v.startAt}` : v.src);
const first = items[0].video;
---

<section
  data-hero
  data-originals
  data-videos={JSON.stringify(items.map((i) => i.video))}
  class="relative isolate flex min-h-svh flex-col justify-between gap-16 overflow-hidden bg-black px-gutter pt-[calc(var(--spacing-nav)+2rem)] pb-8 text-sand lg:h-svh lg:min-h-[44rem]"
>
  <video
    data-originals-video
    class="absolute inset-0 -z-30 size-full object-cover"
    src={withStart(first)}
    poster={first.poster}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"></video>
  <!-- Fades in to black while the video changes. -->
  <div data-originals-fade aria-hidden="true" class="originals-fade absolute inset-0 -z-20 bg-black opacity-0"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-b from-black/60 via-black/10 via-45% to-black/75"></div>

  <h1 class="text-headline">{heading}</h1>

  <div class="grid-split items-end gap-y-12">
    <ProjectList items={items} idPrefix="original" label="Originals" class="lg:w-max lg:min-w-[326px]" />

    <div class="grid">
      {
        items.map((item, i) => (
          <ProjectDetails idPrefix="original" index={i} {...item} tag={item.comingSoon ? 'Coming soon!' : undefined}>
            {item.comingSoon && <NotifyForm id={`original-${i}`} />}
          </ProjectDetails>
        ))
      }
    </div>
  </div>
</section>

<style>
  .originals-fade {
    transition: opacity 0.45s ease-in-out;
  }
  .originals-fade[data-on] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .originals-fade {
      transition: none;
    }
  }
</style>

<script>
  import { initProjectTabs } from '../../scripts/project-tabs';

  type VideoInfo = { src: string; poster?: string; startAt?: number };
  const FADE_MS = 450;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>('[data-originals]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('[data-originals-video]')!;
    const fade = root.querySelector<HTMLElement>('[data-originals-fade]')!;
    const videos: VideoInfo[] = JSON.parse(root.dataset.videos ?? '[]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentSrc = videos[0]?.src;
    let switchId = 0;

    /** Resolves when the video can show the new frame (or after a timeout, so it never sticks on black). */
    const ready = (event: 'seeked' | 'playing') =>
      Promise.race([new Promise((resolve) => video.addEventListener(event, resolve, { once: true })), wait(1500)]);

    const show = async (index: number) => {
      const next = videos[index];
      if (!next) return;
      const id = ++switchId;
      fade.toggleAttribute('data-on', true);
      await wait(reducedMotion ? 0 : FADE_MS);
      if (id !== switchId) return; // a newer selection took over

      if (next.src !== currentSrc) {
        currentSrc = next.src;
        video.poster = next.poster ?? '';
        video.src = next.startAt ? `${next.src}#t=${next.startAt}` : next.src;
        const playing = ready('playing');
        video.play().catch(() => {});
        await playing;
      } else {
        const seeked = ready('seeked');
        video.currentTime = next.startAt ?? 0;
        video.play().catch(() => {});
        await seeked;
      }
      if (id !== switchId) return;
      fade.toggleAttribute('data-on', false);
    };

    initProjectTabs(root, show);
  });
</script>
