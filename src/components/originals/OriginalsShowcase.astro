---
/**
 * OriginalsShowcase — the /originals page's opening screen (Figma 201:1262,
 * second state 201:1637).
 *
 * One viewport tall, over the selected original's background video (muted,
 * looping, inline, from its start time, like the home hero). The header sits
 * transparent over it ([data-hero]), the heading is at the top, and along the
 * bottom are the originals list (ProjectList, left) and the selected
 * original's details (ProjectDetails, right, 5 columns). A light gradient at the top and bottom keeps the sand text
 * readable whatever the video shows.
 *
 * Selecting another original crossfades its details and fades the video to
 * black, switches to that original's video (or restarts it from its start
 * time if it's the same file), then fades back in (videoSwitcher, shared
 * with /work). A coming-soon original gets
 * a "Coming soon!" tag and the notify form instead of links.
 */
import ProjectList from '../ui/ProjectList.astro';
import ProjectDetails from '../ui/ProjectDetails.astro';
import NotifyForm from '../ui/NotifyForm.astro';
import type { Original } from '../../data/site';

interface Props {
  heading: string;
  /** The rest of the heading, in brick red. */
  accent?: string;
  /** A short line above the originals list (e.g. "IP 100% owned by COZM"). */
  listNote?: string;
  items: Original[];
}

const { heading, accent, listNote, items } = Astro.props;
const withStart = (v: Original['video']) => (v.startAt ? `${v.src}#t=${v.startAt}` : v.src);
const first = items[0].video;
---

<section
  data-hero
  data-tone="black"
  data-originals
  data-videos={JSON.stringify(items.map((i) => i.video))}
  class="relative isolate flex min-h-svh flex-col justify-between gap-16 overflow-hidden bg-black px-gutter pt-[calc(var(--spacing-nav)+2rem)] pb-8 text-butter lg:h-svh lg:min-h-[44rem]"
>
  <video
    data-originals-video
    class="absolute inset-0 -z-30 size-full object-cover"
    src={first.sources ? undefined : withStart(first)}
    poster={first.poster}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
  >
    {first.sources?.map((source) => <source src={withStart({ ...first, src: source.src })} type={source.type} />)}
  </video>
  <!-- Fades in to black while the video changes. -->
  <div data-originals-fade aria-hidden="true" class="originals-fade absolute inset-0 -z-20 bg-black opacity-0"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-b from-black/60 via-black/10 via-45% to-black/75"></div>

  <h1 class="text-headline">
    {heading}
    {accent && <span class="text-brick-red"> {accent}</span>}
  </h1>

  <div class="grid-split items-end gap-y-12">
    <div class="flex flex-col gap-3 lg:w-max lg:min-w-[326px]">
      {listNote && <p class="text-label">{listNote}</p>}
      <!-- The arrow links to an original's first CTA (none while it's coming soon). -->
      <ProjectList
        items={items.map((item) => ({ title: item.title, category: item.category, link: item.links?.[0] }))}
        idPrefix="original"
        label="Originals"
      />
    </div>

    <div class="grid">
      {
        items.map((item, i) => (
          <ProjectDetails
            idPrefix="original"
            index={i}
            tone="dark"
            {...item}
            tag={item.comingSoon ? 'Coming soon!' : undefined}
          >
            {item.comingSoon && <NotifyForm id={`original-${i}`} />}
          </ProjectDetails>
        ))
      }
    </div>
  </div>
</section>

<style>
  .originals-fade {
    transition: opacity 0.45s ease-in-out;
  }
  .originals-fade[data-on] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .originals-fade {
      transition: none;
    }
  }
</style>

<script>
  import { initProjectTabs } from '../../scripts/project-tabs';
  import { videoSwitcher } from '../../scripts/video-switch';

  document.querySelectorAll<HTMLElement>('[data-originals]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('[data-originals-video]');
    const fade = root.querySelector<HTMLElement>('[data-originals-fade]');
    if (!video || !fade) return;
    initProjectTabs(root, videoSwitcher(video, fade, JSON.parse(root.dataset.videos ?? '[]')));
  });
</script>
