---
/**
 * WorkRow — two WorkCards side by side (wide 878 + narrow 634 at 1512px),
 * separated by a 1px rule. `reverse` puts the narrow card first.
 * Stacks vertically below lg.
 */
import WorkCard from './WorkCard.astro';
import divider from '../assets/icons/divider-vertical.svg';
import type { WorkItem } from '../data/site';

interface Props {
  items: [WorkItem, WorkItem];
  reverse?: boolean;
}

const { items, reverse = false } = Astro.props;
const [first, second] = items;
---

<div
  class:list={[
    'grid border-t border-ink bg-sand lg:h-[521px]',
    reverse
      ? 'lg:grid-cols-[minmax(0,634fr)_auto_minmax(0,878fr)]'
      : 'lg:grid-cols-[minmax(0,878fr)_auto_minmax(0,634fr)]',
  ]}
>
  <WorkCard {...first} edge="left" />
  <img
    src={divider.src}
    width="1"
    height="520"
    alt=""
    aria-hidden="true"
    class="hidden h-full w-px lg:block"
  />
  <WorkCard {...second} edge="right" class="border-t border-ink lg:border-t-0" />
</div>
