---
/**
 * WorkRow — two full-bleed WorkCards in a 7:5 split of the page grid
 * (5:7 when `reverse`), separated by a 1px rule.
 *
 * Each seam sits exactly on a grid column's left edge, so the card on its right
 * starts on the same line as content in that column above it:
 *   row 1 (7:5): seam on column 8, the page's right-hand keyline (lines up
 *                with "View all work", the nav, CTAs…)
 *   row 2 (5:7): seam on column 6
 * Card text is inset 16px from the seam (WorkCard). Stacks vertically below lg.
 */
import WorkCard from './WorkCard.astro';
import divider from '../assets/icons/divider-vertical.svg';
import type { WorkItem } from '../data/site';

interface Props {
  items: [WorkItem, WorkItem];
  reverse?: boolean;
}

const { items, reverse = false } = Astro.props;
const [first, second] = items;
---

<div
  class:list={['work-row relative grid border-t border-ink bg-sand lg:h-[521px]', reverse && 'work-row--reverse']}
>
  <WorkCard {...first} edge="left" />
  <WorkCard {...second} edge="right" class="border-t border-ink lg:border-t-0" />
  <!-- 1px rule over the seam (absolutely positioned so it doesn't shift the columns) -->
  <img
    src={divider.src}
    width="1"
    height="520"
    alt=""
    aria-hidden="true"
    class="work-row__divider pointer-events-none absolute inset-y-0 hidden h-full w-px lg:block"
  />
</div>

<style>
  @media (width >= 64rem) {
    .work-row {
      /* One page-grid column, computed against this full-bleed row's width. */
      --track: calc((100% - 2 * var(--spacing-gutter) - 11 * var(--spacing-column-gap)) / 12);
      /* Seam = left edge of column N + 1 = page gutter + N columns + N gaps. */
      --seam: calc(var(--spacing-gutter) + 7 * var(--track) + 7 * var(--spacing-column-gap));
      grid-template-columns: var(--seam) minmax(0, 1fr);
    }

    .work-row--reverse {
      --seam: calc(var(--spacing-gutter) + 5 * var(--track) + 5 * var(--spacing-column-gap));
    }

    .work-row__divider {
      left: var(--seam);
    }
  }
</style>
