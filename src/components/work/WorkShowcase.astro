---
/**
 * WorkShowcase — the /work page's single screen (Figma node 201:1576).
 *
 * Desktop (one viewport tall, below the fixed header): a 7-column media frame
 * on the left with the project list in its bottom-left corner, and on the right
 * (5 columns) the page heading at the top and the selected project's details
 * at the bottom. Below lg it stacks: heading, media, list, details.
 *
 * Clicking a project in the list (or arrow keys / Home / End once the list has
 * focus) selects it: its cover crossfades in and its details replace the
 * previous ones. WAI-ARIA tabs pattern with automatic activation and a roving
 * tabindex, like WhatWeDo.
 *
 * Covers and detail panels share one grid cell each, so switching never
 * changes the layout. Without JS they all show, one after another.
 */
import { Image } from 'astro:assets';
import arrowUpRight from '../../assets/icons/arrow-up-right.svg';
import Button from '../ui/Button.astro';
import type { WorkProject } from '../../data/site';

interface Props {
  heading: string;
  projects: WorkProject[];
}

const { heading, projects } = Astro.props;
const id = (i: number, part: string) => `work-${i}-${part}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section
  data-work-showcase
  class="grid gap-y-8 bg-sand px-gutter pt-[calc(var(--spacing-nav)+2rem)] pb-section lg:h-svh lg:min-h-[44rem] lg:grid-12 lg:grid-rows-[auto_1fr] lg:pb-4"
>
  <h1 class="text-headline lg:col-span-5 lg:col-start-8 lg:row-start-1">{heading}</h1>

  <!-- Media frame with the project list in its bottom-left corner -->
  <div class="flex flex-col gap-4 lg:relative lg:col-span-7 lg:col-start-1 lg:row-span-2 lg:row-start-1">
    <div class="work-covers relative grid aspect-[4/3] overflow-hidden border border-ink bg-ink lg:aspect-auto lg:h-full">
      {
        projects.map(({ item }, i) => (
          <div data-work-cover data-active={i === 0 ? '' : undefined} class="work-cover relative aspect-[4/3] lg:aspect-auto">
            <Image
              src={item.image}
              alt=""
              class="absolute inset-0 size-full object-cover grayscale"
              style={`object-position: ${item.position ?? '50% 50%'}`}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 64rem) 52vw, 100vw"
            />
          </div>
        ))
      }
    </div>

    <div
      role="tablist"
      aria-label="Projects"
      aria-orientation="vertical"
      class="flex flex-col divide-y divide-ink lg:absolute lg:bottom-2 lg:left-2 lg:w-[326px] lg:bg-sand lg:p-2"
    >
      {
        projects.map(({ item, category }, i) => (
          <button
            type="button"
            role="tab"
            id={id(i, 'tab')}
            aria-controls={id(i, 'panel')}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-work-tab
            class="flex cursor-pointer items-center gap-4 py-2 text-left text-caption leading-[1.3] opacity-40 transition-opacity duration-300 first:pt-0 last:pb-0 hover:opacity-70 aria-selected:opacity-100"
          >
            <span>{pad(i)}</span>
            <span class="min-w-0 flex-1">{item.title}</span>
            <span class="whitespace-nowrap">{category}</span>
            <img src={arrowUpRight.src} width={16} height={16} alt="" class="m-px shrink-0" />
          </button>
        ))
      }
    </div>
  </div>

  <!-- Details of the selected project -->
  <div class="work-panels grid gap-y-16 lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:self-end">
    {
      projects.map(({ item, about, facts, credit = 'Produced by COZM', watch, related }, i) => (
        <div
          role="tabpanel"
          id={id(i, 'panel')}
          aria-labelledby={id(i, 'tab')}
          data-work-panel
          data-active={i === 0 ? '' : undefined}
          class="work-panel flex flex-col gap-4 self-end"
        >
          <h2 class="text-lead leading-[1.2] font-semibold">{item.title}</h2>
          <p class="text-small">{item.description}</p>
          <p class="text-small">{about}</p>
          {facts.length > 0 && (
            <dl class="grid grid-cols-2 gap-x-4 gap-y-4">
              {facts.map((fact, f) => (
                // An odd last fact (e.g. notable guests) gets the full row.
                <div class:list={['flex flex-col gap-0.5', f === facts.length - 1 && f % 2 === 0 && 'col-span-2 max-w-[409px]']}>
                  <dt class="text-caption leading-[1.2] font-semibold text-ink/60 uppercase">{fact.label}</dt>
                  <dd class="text-small">{fact.value}</dd>
                </div>
              ))}
            </dl>
          )}
          <p class="text-label">{credit}</p>
          <div class:list={['grid gap-4', related && 'sm:grid-cols-2']}>
            <Button href={watch} target="_blank" rel="noopener">
              Watch on Youtube
            </Button>
            {related && <Button href={related.href}>{related.label}</Button>}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* With JS: covers and panels stack in one cell and crossfade; only the
     active one is visible. */
  :global(html.js) .work-cover,
  :global(html.js) .work-panel {
    grid-area: 1 / 1;
    transition:
      opacity 0.4s ease,
      visibility 0.4s;
  }
  :global(html.js) .work-cover:not([data-active]),
  :global(html.js) .work-panel:not([data-active]) {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .work-cover,
    .work-panel {
      transition: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-work-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-work-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-work-panel]')];
    const covers = [...root.querySelectorAll<HTMLElement>('[data-work-cover]')];
    let current = 0;

    const select = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      [...panels, ...covers].forEach((el) => el.toggleAttribute('data-active', false));
      panels[index].toggleAttribute('data-active', true);
      covers[index].toggleAttribute('data-active', true);
      // Hidden panels stay out of the tab order and the accessibility tree.
      panels.forEach((panel, i) => (panel.inert = i !== index));
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next = {
          ArrowDown: current === last ? 0 : current + 1,
          ArrowRight: current === last ? 0 : current + 1,
          ArrowUp: current === 0 ? last : current - 1,
          ArrowLeft: current === 0 ? last : current - 1,
          Home: 0,
          End: last,
        }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(next, true);
      });
    });

    select(0);
  });
</script>
