---
/**
 * ServicesTicker — endlessly scrolling band of services, separated by the
 * cross icon. The list is rendered twice and the track slides by exactly one
 * copy (-50%), so the loop is seamless. Stops for prefers-reduced-motion.
 */
import tickerIcon from '../assets/icons/ticker-icon.svg';

interface Props {
  items: string[];
  /** Seconds for one full pass of the list. Higher is slower. */
  duration?: number;
}

const { items, duration = 60 } = Astro.props;
---

<div
  class="services-ticker overflow-hidden border-t border-ink bg-sand py-6"
  role="region"
  aria-label="What we make"
  style={`--ticker-duration: ${duration}s`}
>
  <div class="services-ticker__track flex w-max">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center gap-6 pr-6" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <>
              <li class="shrink-0 text-eyebrow whitespace-nowrap uppercase">{item}</li>
              <li aria-hidden="true" class="shrink-0">
                <img src={tickerIcon.src} width="24" height="24" alt="" class="block size-6" />
              </li>
            </>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .services-ticker__track {
    animation: services-ticker var(--ticker-duration) linear infinite;
  }

  @keyframes services-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-ticker__track {
      animation: none;
    }
  }
</style>
