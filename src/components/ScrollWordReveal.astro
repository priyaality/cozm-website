---
/**
 * ScrollWordReveal — large statement copy whose words fade from faint to full
 * opacity, one after another, as the page scrolls (no pinning).
 *
 * The per-word animation follows motion.dev's "Text scroll word reveal":
 * word i starts at (i / (n-1)) × SPREAD of the scroll progress and takes
 * WORD_DURATION of it to reach full opacity.
 *
 * The scroll range is measured from the layout so that:
 *  - by the time the section's top edge reaches `landAt` (a fraction of the
 *    viewport height, 0.5 = middle of the screen), the whole first paragraph
 *    is fully highlighted, and
 *  - the last word is fully highlighted once `completeAt` of the section
 *    (0.7 = 70%) has scrolled out of the top of the viewport.
 *
 * Without JS, or with prefers-reduced-motion, all text is shown at full opacity.
 */
interface Props {
  paragraphs: string[];
  /** Opacity of unrevealed words. Matches the design's faint ink (40%). */
  startOpacity?: number;
  /** Where the section top sits (fraction of viewport height) when the first paragraph is fully lit. */
  landAt?: number;
  /** Fraction of the section scrolled out of the viewport when every word is fully lit. */
  completeAt?: number;
}

const { paragraphs, startOpacity = 0.4, landAt = 0.5, completeAt = 0.7 } = Astro.props;
---

<section
  data-word-reveal
  data-start-opacity={startOpacity}
  data-land-at={landAt}
  data-complete-at={completeAt}
  class="border-t border-ink bg-sand px-gutter py-section"
>
  <div data-reveal-content class="text-statement">
    {
      paragraphs.map((paragraph, i) => (
        <p class:list={[i < paragraphs.length - 1 && 'mb-10']}>
          {paragraph.split(/\s+/).map((word) => (
            <>
              <span class="word-reveal__word">{word}</span>{' '}
            </>
          ))}
        </p>
      ))
    }
  </div>
</section>

<style>
  .word-reveal__word {
    opacity: var(--word-opacity, 1);
  }
</style>

<script>
  import { scroll } from 'motion';

  const SPREAD = 0.8;
  const WORD_DURATION = 0.2;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-word-reveal]').forEach((root) => {
    const content = root.querySelector<HTMLElement>('[data-reveal-content]')!;
    const words = [...content.querySelectorAll<HTMLElement>('.word-reveal__word')];
    const firstParagraphWords = content.querySelectorAll('p:first-child .word-reveal__word');
    const startOpacity = Number(root.dataset.startOpacity ?? 0.4);
    const landAt = Number(root.dataset.landAt ?? 0.5);
    const completeAt = Number(root.dataset.completeAt ?? 0.7);
    const count = words.length;
    let cancel: VoidFunction | undefined;

    /** Progress at which word `index` becomes fully opaque. */
    const wordEnd = (index: number) =>
      Math.min(1, (count <= 1 ? 0 : (index / (count - 1)) * SPREAD) + WORD_DURATION);

    const render = (progress: number) => {
      words.forEach((word, index) => {
        const end = wordEnd(index);
        const start = end - WORD_DURATION;
        const t = progress <= start ? 0 : progress >= end ? 1 : (progress - start) / (end - start);
        word.style.setProperty('--word-opacity', String(startOpacity + (1 - startOpacity) * t));
      });
    };

    const setup = () => {
      cancel?.();
      cancel = undefined;

      if (reducedMotion.matches) {
        words.forEach((word) => word.style.removeProperty('--word-opacity'));
        return;
      }

      // All positions below are the section's top edge, in px from the viewport top.
      const viewport = window.innerHeight;
      const sectionRect = root.getBoundingClientRect();
      const lastFirstWord = firstParagraphWords[firstParagraphWords.length - 1] as HTMLElement;
      // Distance from the section top to the bottom of the first paragraph.
      const firstParagraphDepth = lastFirstWord.getBoundingClientRect().bottom - sectionRect.top;

      // "Landed": the first paragraph is fully lit. Clamped so that paragraph is
      // still on screen at that moment (matters for tall copy on small screens).
      const landedTop = Math.min(landAt * viewport, viewport * 0.9 - firstParagraphDepth);
      // "Complete": every word is lit, once `completeAt` of the section is above the viewport.
      const completeTop = -completeAt * sectionRect.height;

      // Progress is linear in scroll. Pin it to the two moments above, then extend
      // backwards to find where it starts (progress 0).
      const landedProgress = wordEnd(firstParagraphWords.length - 1);
      const range = (landedTop - completeTop) / (1 - landedProgress);
      const startTop = landedTop + landedProgress * range;

      cancel = scroll(render, {
        target: root,
        offset: [`start ${startTop / viewport}`, `start ${completeTop / viewport}`],
      });
    };

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 150);
    });
    reducedMotion.addEventListener('change', setup);
    document.fonts.ready.then(setup);
    setup();
  });
</script>
