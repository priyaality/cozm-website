---
/**
 * Header — overlays the hero media. Logo left; nav + "Talk to us" aligned to
 * the right-hand 554px column. Below lg the links collapse into a menu.
 */
import Logo from './ui/Logo.astro';
import NavLinks from './ui/NavLinks.astro';
import Button from './ui/Button.astro';
import { contactHref, navLinks } from '../data/site';
---

<header class="absolute inset-x-0 top-0 z-10 px-gutter pt-6">
  <div class="grid-split items-start">
    <a href="/" class="block w-fit px-3 py-2" aria-label="Cozm home">
      <Logo class="w-[79px]" />
    </a>

    <!-- Desktop -->
    <nav class="hidden items-start justify-between lg:flex" aria-label="Primary">
      <NavLinks tone="sand" />
      <Button href={contactHref} variant="inverse" size="sm">Talk to us</Button>
    </nav>

    <!-- Mobile -->
    <details class="group absolute top-6 right-gutter lg:hidden">
      <summary
        class="cursor-pointer list-none border border-sand px-6 py-[9px] text-nav text-sand [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-56 flex-col border border-sand bg-ink p-4"
        aria-label="Primary"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="py-3 text-nav text-sand">
              {link.label}
            </a>
          ))
        }
        <Button href={contactHref} variant="inverse" size="sm" class="mt-2">Talk to us</Button>
      </nav>
    </details>
  </div>
</header>
