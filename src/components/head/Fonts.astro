---
/**
 * Fonts — goes in <head>. Self-hosted font faces (Fontsource files, Latin
 * subset, woff2 only), preloads for the two faces every page paints first, and
 * the font picker's pre-paint script (when enabled; see ../dev/enabled.ts).
 *
 * Only the Latin subset is declared: the copy is English and every character it
 * uses (curly quotes, dashes, ©, −) is in Fontsource's Latin unicode-range. The
 * `→` in a couple of strings isn't in any subset of these fonts, so it falls
 * back to a system font either way.
 *
 * The face rules are inlined rather than bundled: a few hundred bytes per page,
 * and the browser knows the font URLs without waiting for the stylesheet.
 *
 * "… Fallback" faces are local Arial, scaled and with line metrics overridden
 * to match Plus Jakarta Sans (at the heading weight, 550) and DM Sans, so
 * swapping in the web font moves the text as little as possible. Metrics
 * computed with fontTools from the woff2 files against macOS's Arial.ttf,
 * averaged over the site's copy. They're in the --font-heading / --font-body
 * stacks in global.css.
 */
import plusJakartaSans from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
// Not preloaded: only the approach dial's agency lines use it, so it loads when they render.
import dmSansItalic from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-italic.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import caveat from '@fontsource/caveat/files/caveat-latin-400-normal.woff2?url';
import FontPickerHead from '../dev/FontPickerHead.astro';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const face = (family: string, url: string, weight: string, format = 'woff2', style = 'normal') =>
  `@font-face{font-family:'${family}';font-style:${style};font-display:swap;font-weight:${weight};` +
  `src:url(${url}) format('${format}');unicode-range:${LATIN}}`;

const fallback = (family: string, local: string, m: string) =>
  `@font-face{font-family:'${family}';src:local('${local}');${m}}`;

const css = [
  face('Plus Jakarta Sans Variable', plusJakartaSans, '200 800', 'woff2-variations'),
  face('DM Sans Variable', dmSans, '100 1000', 'woff2-variations'),
  face('DM Sans Variable', dmSansItalic, '100 1000', 'woff2-variations', 'italic'),
  face('IBM Plex Mono', plexMono, '400'),
  face('Caveat', caveat, '400'),
  fallback(
    'Plus Jakarta Sans Fallback',
    'Arial',
    'size-adjust:106.36%;ascent-override:97.59%;descent-override:20.87%;line-gap-override:0%',
  ),
  fallback(
    'DM Sans Fallback',
    'Arial',
    'size-adjust:104.34%;ascent-override:95.07%;descent-override:29.71%;line-gap-override:0%',
  ),
].join('');
---

<link rel="preload" href={plusJakartaSans} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />
<FontPickerHead />
