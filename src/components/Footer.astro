---
/**
 * Footer — closing CTA (right) with logo, nav and legal (left), over a faded
 * film-strip graphic in the top-left corner. The graphic is a pre-treated
 * export (grain, tone and transparency baked in) at 2× its 552×545 size.
 */
import { Image } from 'astro:assets';
import Logo from './ui/Logo.astro';
import NavLinks from './ui/NavLinks.astro';
import Button from './ui/Button.astro';
import filmStrip from '../assets/images/footer-film.png';
import { contactHref } from '../data/site';
---

<footer class="relative overflow-hidden border-t border-ink bg-sand px-gutter py-section">
  <Image
    src={filmStrip}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-0 w-[552px] max-w-none max-lg:hidden"
    widths={[552, 1104]}
    sizes="552px"
  />

  <!-- Desktop: 7/5 page grid. Mobile: stacked with the CTA first. -->
  <div class="relative grid-split items-start gap-y-16">
    <div class="order-last flex w-[285px] flex-col gap-16 lg:order-none">
      <div class="flex flex-col gap-6">
        <Logo class="w-[158px]" />
        <nav aria-label="Footer">
          <NavLinks direction="column" />
        </nav>
      </div>
      <div class="flex flex-col gap-2 text-caption whitespace-nowrap">
        <p>© 2026 by COZM Entertainment Private Limited</p>
        <p>Website by Supercollective Studio</p>
      </div>
    </div>

    <div class="flex flex-col gap-[22px]">
      <h2 class="text-headline lg:text-right">
        If India’s top 10% is who you want to reach, let’s talk about what your first 90 days could
        look like.
      </h2>
      <Button href={contactHref} variant="primary">Start a conversation</Button>
    </div>
  </div>
</footer>
