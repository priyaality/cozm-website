---
/**
 * FontPickerHead — goes in <head>. Applies saved font choices before first
 * paint (no flash of the default fonts) and exposes `window.cozmFonts` for the
 * picker (FontPicker.astro).
 *
 * The picker is shown to everyone, on every build (dev and the deployed site).
 * Choices are saved per browser.
 */
import { DEFAULT_FONTS, fontsByRole } from '../../data/fonts';
---

<script is:inline define:vars={{ fontsByRole, DEFAULT_FONTS }}>
  (() => {
    const KEY = 'cozm-fonts';
    const root = document.documentElement;
    const store = {
      get: (k) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k, v) => {
        try {
          if (v === null) localStorage.removeItem(k);
          else localStorage.setItem(k, v);
        } catch {}
      },
    };

    let saved = {};
    try {
      saved = JSON.parse(store.get(KEY) || '{}') || {};
    } catch {}

    const stacks = {
      'sans-serif': 'ui-sans-serif, system-ui, sans-serif',
      serif: 'ui-serif, Georgia, serif',
    };

    /** Load a Google font (weights 400–600) once. */
    const load = (option) => {
      if (!option.google) return;
      const id = `font-${option.name.replace(/\s+/g, '-')}`;
      if (document.getElementById(id)) return;
      const link = Object.assign(document.createElement('link'), {
        id,
        rel: 'stylesheet',
        href: `https://fonts.googleapis.com/css2?family=${option.google}&display=swap`,
      });
      document.head.append(link);
    };

    const HEADING_STYLES = ['display', 'headline', 'title'];

    /** role: 'heading' | 'body'. The defaults are in global.css, so picking one clears the overrides. */
    const apply = (role, name) => {
      const option = fontsByRole[role].find((o) => o.name === name);
      const isDefault = !option || name === DEFAULT_FONTS[role];
      if (isDefault) {
        root.style.removeProperty(`--font-${role}`);
      } else {
        load(option);
        root.style.setProperty(`--font-${role}`, `"${option.family || option.name}", ${stacks[option.fallback]}`);
      }
      if (role !== 'heading') return;
      // Heading weights and optical size: the font's own, or the defaults (Literata's).
      const weights = !isDefault && option.headingWeights;
      for (const style of HEADING_STYLES) {
        const token = `--text-${style}--font-weight`;
        if (weights) root.style.setProperty(token, String(weights[style]));
        else root.style.removeProperty(token);
      }
      if (!isDefault && option.headingOpsz) root.style.setProperty('--heading-opsz', String(option.headingOpsz));
      else root.style.removeProperty('--heading-opsz');
    };

    // A saved font that's no longer offered for its role falls back to the default.
    const pick = (role) =>
      fontsByRole[role].some((o) => o.name === saved[role]) ? saved[role] : DEFAULT_FONTS[role];
    const current = () => ({ heading: pick('heading'), body: pick('body') });

    window.cozmFonts = {
      fontsByRole,
      current,
      set(role, name) {
        saved = { ...current(), [role]: name };
        store.set(KEY, JSON.stringify(saved));
        apply(role, name);
      },
      reset() {
        saved = {};
        store.set(KEY, null);
        apply('heading', DEFAULT_FONTS.heading);
        apply('body', DEFAULT_FONTS.body);
      },
    };

    apply('heading', current().heading);
    apply('body', current().body);
  })();
</script>
