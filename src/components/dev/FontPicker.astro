---
/**
 * FontPicker — a floating "Aa" button (bottom-right) that opens a panel for
 * choosing the heading and body fonts from a short list (src/data/fonts.ts).
 * The choice is saved in this browser and applied site-wide by
 * FontPickerHead. Shown on every page, in dev and on the deployed site.
 *
 * The panel is a native popover: it closes on Escape or a click outside.
 * Each option is shown in its own face (only the letters of the font names are
 * fetched for the previews, when the panel first opens).
 */
import { fontsByRole, type FontOption } from '../../data/fonts';

const roles = [
  { role: 'heading', label: 'Heading' },
  { role: 'body', label: 'Body' },
] as const;
const stack = (o: FontOption) =>
  `"${o.family ?? o.name}", ${o.fallback === 'serif' ? 'ui-serif, Georgia, serif' : 'ui-sans-serif, system-ui, sans-serif'}`;
---

<div data-font-picker class="font-picker-root">
  <button
    type="button"
    popovertarget="font-picker-panel"
    aria-label="Choose fonts"
    class="fixed right-4 bottom-4 z-[60] grid size-12 cursor-pointer place-items-center border border-ink bg-sand text-label text-ink shadow-[0_4px_12px_rgb(0_0_0/0.2)] max-lg:bottom-24"
  >
    Aa
  </button>

  <div
    id="font-picker-panel"
    popover
    class="font-picker-panel m-0 w-[min(26rem,calc(100vw-2rem))] border border-ink bg-sand p-5 text-ink shadow-[0_8px_24px_rgb(0_0_0/0.25)]"
  >
    <div class="flex items-baseline justify-between gap-4">
      <p class="text-label">Fonts</p>
      <button type="button" data-font-reset class="cursor-pointer text-caption underline underline-offset-2">
        Reset to defaults
      </button>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-6">
      {
        roles.map(({ role, label }) => (
          <fieldset class="flex flex-col gap-1">
            <legend class="mb-2 text-caption font-semibold text-ink/60 uppercase">{label}</legend>
            {fontsByRole[role].map((o) => (
              <label class="flex cursor-pointer items-center gap-2 py-0.5 text-small has-checked:font-semibold">
                <input type="radio" name={`font-${role}`} value={o.name} class="accent-ink" />
                <span style={`font-family: ${stack(o)}`}>{o.name}</span>
              </label>
            ))}
          </fieldset>
        ))
      }
    </div>

    <p class="mt-4 text-caption leading-[1.3] text-ink/60">
      Saved in this browser only. Headings are the display, headline and title styles; everything else is body.
    </p>
  </div>
</div>

<style is:global>
  /* It needs JS to do anything. */
  html:not(.js) [data-font-picker] {
    display: none;
  }
  /* Popovers are centred by default; anchor this one above the button. */
  .font-picker-panel:popover-open {
    position: fixed;
    inset: auto 1rem 5rem auto;
  }
  @media (max-width: 63.999rem) {
    .font-picker-panel:popover-open {
      bottom: 11rem;
    }
  }
</style>

<script>
  type Role = 'heading' | 'body';
  interface CozmFonts {
    fontsByRole: Record<Role, { name: string; google?: string }[]>;
    current: () => Record<Role, string>;
    set: (role: Role, name: string) => void;
    reset: () => void;
  }
  const fonts = (window as unknown as { cozmFonts?: CozmFonts }).cozmFonts;
  const panel = document.getElementById('font-picker-panel');

  if (fonts && panel) {
    const radios = [...panel.querySelectorAll<HTMLInputElement>('input[type=radio]')];
    const sync = () => {
      const current = fonts.current();
      radios.forEach((r) => (r.checked = current[r.name.replace('font-', '') as Role] === r.value));
    };
    sync();

    radios.forEach((radio) =>
      radio.addEventListener('change', () => fonts.set(radio.name.replace('font-', '') as Role, radio.value)),
    );
    panel.querySelector('[data-font-reset]')?.addEventListener('click', () => {
      fonts.reset();
      sync();
    });

    // Previews: on first open, fetch just the letters of the font names.
    let previewsLoaded = false;
    panel.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open' || previewsLoaded) return;
      previewsLoaded = true;
      const google = [...fonts.fontsByRole.heading, ...fonts.fontsByRole.body].filter((o) => o.google);
      const letters = [...new Set(google.map((o) => o.name).join(''))].join('');
      const families = google.map((o) => `family=${o.google!.split(':')[0]}`).join('&');
      const link = Object.assign(document.createElement('link'), {
        rel: 'stylesheet',
        href: `https://fonts.googleapis.com/css2?${families}&text=${encodeURIComponent(letters)}&display=swap`,
      });
      document.head.append(link);
    });
  }
</script>
