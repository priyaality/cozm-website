---
/**
 * FontPicker — goes in <body>. Renders the font picker panel only when the
 * picker is enabled (dev, or PUBLIC_FONT_PICKER=true; see ./enabled.ts), so a
 * production build ships none of it.
 */
import { fontPickerEnabled } from './enabled';
import FontPickerPanel from './FontPickerPanel.astro';
---

{fontPickerEnabled && <FontPickerPanel />}
