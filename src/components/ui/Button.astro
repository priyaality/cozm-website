---
/**
 * Button — the rectangular CTA used throughout the design. Renders a link when
 * given an `href`, otherwise a <button type="button">.
 *
 * variant
 *   primary   ink fill, sand label            ("Talk to us", "Start a conversation")
 *   secondary sand fill, ink border + label    ("Learn our approach", "View all work"…)
 *   ghost     transparent, border + label in the current text colour
 *             (header "Talk to us": sand over the hero, ink once scrolled)
 * size
 *   lg    full-width block CTA, 28/40 padding, button-text type
 *   sm    compact button, 9/24 padding, nav type
 *   xs    small inline control (e.g. the hero's Pause), caption type
 *   icon  56px square for a single icon (e.g. the hero's scroll-down button)
 */
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../../lib/paths';

type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> & {
  href?: string;
  /** For the <button> form (no href): 'submit' inside a form. */
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'lg' | 'sm' | 'xs' | 'icon';
};

const { href, type = 'button', variant = 'secondary', size = 'lg', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-ink text-sand border-ink',
  secondary: 'bg-sand text-ink border-ink',
  ghost: 'bg-transparent text-current border-current',
};

const sizes = {
  lg: 'w-full px-10 py-7 button-text',
  sm: 'px-6 py-[9px] text-nav',
  xs: 'gap-1.5 px-3 py-1.5 text-caption font-semibold',
  icon: 'size-14',
};

const classes = [
  'inline-flex items-center justify-center border text-center whitespace-nowrap',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={withBase(href)} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
