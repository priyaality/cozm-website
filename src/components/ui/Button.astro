---
/**
 * Button — the rectangular CTA used throughout the design. Renders a link when
 * given an `href`, otherwise a <button type="button">.
 *
 * variant (Figma: homepage, node 304:2345)
 *   primary   filled, no border; colours follow the section behind it (global.css):
 *             butter → brick red, brick red → black, black → butter
 *             ("Talk to us", "Start a conversation", "Notify me", "Back to home")
 *   secondary butter fill, black border + label        ("Learn our approach", "Talk to us"…)
 *   outline   brick-red fill, butter border + label    (on brick-red sections: "View all work"…)
 *   dark      black fill, butter border + label        (not used at the moment)
 *   ghost     transparent, border + label in the current text colour (mobile menu, "Also playing",
 *             /originals "Listen on Spotify"…)
 *   red       brick-red fill, butter label             (the hero card's Play / Pause)
 * size
 *   lg    full-width block CTA, 28/40 padding, button-text type (20 / semibold)
 *   sm    compact button, 10/24 padding, 16 / semibold (header "Talk to us")
 *   xs    small inline control (the hero card's Play / Pause, Also playing), caption type
 *   icon  56px square for a single icon (e.g. the hero's scroll-down button)
 *
 * Label centring: a label is centred by its line box, which includes room below
 * the baseline for descenders, so text without any (most labels) sits a little
 * high. Where the browser supports `text-box`, the label is trimmed to its
 * capitals and baseline (optical centring); a minimum height of padding + one
 * line keeps buttons their exact heights whatever the font.
 * lg / sm wrap the label for this; xs buttons (icon + text) put their text in a
 * <span class="button-label"> themselves (see NowPlaying).
 */
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../../lib/paths';

type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> & {
  href?: string;
  /** For the <button> form (no href): 'submit' inside a form. */
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'outline' | 'dark' | 'ghost' | 'red';
  size?: 'lg' | 'sm' | 'xs' | 'icon';
};

const { href, type = 'button', variant = 'secondary', size = 'lg', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-(--cta-bg) text-(--cta-fg) border-transparent',
  secondary: 'bg-butter text-black border-black',
  outline: 'bg-brick-red text-butter border-butter',
  dark: 'bg-black text-butter border-butter',
  ghost: 'bg-transparent text-current border-current',
  red: 'bg-brick-red text-butter border-brick-red',
};

/** --btn-py: vertical padding (before the label-trim adjustment). */
const sizes = {
  lg: 'button-pad w-full px-10 [--btn-py:1.75rem] button-text',
  sm: 'button-pad px-6 [--btn-py:0.625rem] text-nav font-semibold leading-none',
  xs: 'button-pad gap-2 px-3 [--btn-py:0.375rem] text-caption leading-none',
  icon: 'size-14',
};
/** Sizes whose label Button wraps itself (xs labels sit beside icons). */
const wrapLabel = size === 'lg' || size === 'sm';

const classes = [
  'inline-flex items-center justify-center border text-center whitespace-nowrap',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={withBase(href)} class:list={classes} {...rest}>
      {wrapLabel ? (
        <span class="button-label">
          <slot />
        </span>
      ) : (
        <slot />
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {wrapLabel ? (
        <span class="button-label">
          <slot />
        </span>
      ) : (
        <slot />
      )}
    </button>
  )
}

<style is:global>
  /* Height is the padding + one line + the 1px borders, the same with or
     without the label trim below; the content is centred in it. */
  .button-pad {
    padding-block: var(--btn-py);
    min-height: calc(2 * var(--btn-py) + 1lh + 2px);
  }
  /* Optical centring (see above): the label is trimmed to cap height and
     baseline, so centring it centres the letters. Ignored by browsers
     without text-box, which centre the line box as before. */
  .button-label {
    text-box: trim-both cap alphabetic;
  }
</style>
