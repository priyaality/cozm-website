---
/**
 * NavLinks — the Approach / Work / Originals / About list.
 * In the header row, colours come from the header (--nav-link, --nav-active;
 * see Header.astro): the current page is in the active colour with a 2px rule
 * above and below, and hovered / focused links get the rules. In the footer
 * column, links inherit the surrounding text colour.
 */
import { navLinks } from '../../data/site';
import { withBase, withoutBase } from '../../lib/paths';

interface Props {
  /**
   * row: items flow into the parent flex container (display: contents), so the
   *      header can space links + CTA evenly across its 554px column.
   * column: stacked list.
   */
  direction?: 'row' | 'column';
  class?: string;
}

const { direction = 'row', class: className } = Astro.props;
/** The link for the page being viewed (trailing slash ignored). */
const here = withoutBase(Astro.url.pathname);
---

<ul class:list={[direction === 'row' ? 'contents' : 'flex flex-col items-start', className]}>
  {
    navLinks.map((link) => (
      <li>
        <a
          href={withBase(link.href)}
          aria-current={link.href === here ? 'page' : undefined}
          class:list={[
            'block text-nav whitespace-nowrap',
            direction === 'row'
              ? // Header: the borders are always there, transparent, with 7px padding (9px in
                // Figma minus the 2px rule) so nothing shifts when they appear.
                'border-y-2 border-transparent py-[7px] text-(--nav-link) transition-colors duration-200 hover:border-(--nav-active) focus-visible:border-(--nav-active) focus-visible:outline-none aria-[current=page]:border-(--nav-active) aria-[current=page]:text-(--nav-active)'
              : 'py-3',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
