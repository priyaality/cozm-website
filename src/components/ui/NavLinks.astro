---
/**
 * NavLinks — the Approach / Work / Originals / About list. Links inherit the
 * surrounding text colour (sand/ink in the header, ink in the footer).
 */
import { navLinks } from '../../data/site';

interface Props {
  /**
   * row: items flow into the parent flex container (display: contents), so the
   *      header can space links + CTA evenly across its 554px column.
   * column: stacked list.
   */
  direction?: 'row' | 'column';
  class?: string;
}

const { direction = 'row', class: className } = Astro.props;
---

<ul class:list={[direction === 'row' ? 'contents' : 'flex flex-col items-start', className]}>
  {
    navLinks.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={['block text-nav whitespace-nowrap', direction === 'row' ? 'py-[9px]' : 'py-3']}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
