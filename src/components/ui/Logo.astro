---
/**
 * Logo — the COZM wordmark. The source PNG has transparent padding, so it is
 * cropped exactly as in Figma (79×20 visible area). Scale it with `class`
 * (e.g. w-[79px] for the header, w-[158px] for the footer).
 */
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['relative block aspect-[79/20] overflow-hidden', className]}>
  <Image
    src={logo}
    alt="Cozm"
    class="absolute top-[-120.34%] left-[-22.75%] h-[352.54%] w-[145.06%] max-w-none"
    widths={[240, 338]}
    sizes="240px"
  />
</span>
