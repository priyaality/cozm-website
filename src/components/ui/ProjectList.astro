---
/**
 * ProjectList — the numbered project list used on /work and /originals:
 * "01  Title  Category  ↗", one row per project, divided by 1px rules. The
 * selected row is full strength and the others are faded.
 *
 * Each row is two controls side by side: a button (number, title, category)
 * that selects the project — it has aria-pressed and controls the panel
 * `${idPrefix}-${i}-panel` — and the ↗ arrow, a link to the project's main
 * CTA (opens in a new tab; left out when there's no link, e.g. coming soon).
 * Wire it up with initProjectTabs() from src/scripts/project-tabs.ts.
 *
 * Colours follow the text colour (`currentColor`), so the same list works in ink
 * on sand (/work) and in sand over video (/originals). The arrow is the Figma
 * icon used as a mask, so it takes the text colour too.
 */
import arrowUpRight from '../../assets/icons/arrow-up-right.svg';

interface Props {
  items: { title: string; category: string; link?: { label: string; href: string } }[];
  /** Prefix for the button and panel ids. */
  idPrefix: string;
  label: string;
  class?: string;
}

const { items, idPrefix, label, class: className } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<ul aria-label={label} class:list={['flex flex-col divide-y divide-current', className]}>
  {
    items.map(({ title, category, link }, i) => (
      <li class="flex items-center gap-4 py-2 text-small leading-[1.3] opacity-40 transition-opacity duration-300 first:pt-0 last:pb-0 hover:opacity-70 has-[[aria-pressed=true]]:opacity-100">
        <button
          type="button"
          id={`${idPrefix}-${i}-tab`}
          aria-controls={`${idPrefix}-${i}-panel`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-project-tab
          class="flex min-w-0 flex-1 cursor-pointer items-center gap-4 text-left"
        >
          <span>{pad(i)}</span>
          <span class="min-w-0 flex-1">{title}</span>
          <span class="whitespace-nowrap">{category}</span>
        </button>
        {link ? (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={`${link.label}: ${title} (opens in a new tab)`}
            class="-m-1 grid shrink-0 place-items-center p-1"
          >
            <span
              aria-hidden="true"
              class="m-px size-4 bg-current"
              style={`mask: url(${arrowUpRight.src}) center / contain no-repeat`}
            />
          </a>
        ) : (
          // Keeps the column aligned when a project has no link.
          <span aria-hidden="true" class="size-[18px] shrink-0" />
        )}
      </li>
    ))
  }
</ul>
