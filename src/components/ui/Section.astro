---
/**
 * Section — page band with the design's 1px top rule and standard gutters.
 *
 * tone
 *   butter  butter background, black text (default)
 *   red     brick-red background, butter text
 * The top rule is black on both.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'section'> & {
  /** Render a <div> when the band sits inside another section (avoids an unlabelled nested landmark). */
  as?: 'section' | 'div';
  tone?: 'butter' | 'red';
  /** Draw the 1px rule along the top edge. */
  rule?: boolean;
  /** Apply the standard 80px vertical padding. */
  padded?: boolean;
};

const { as: Tag = 'section', tone = 'butter', rule = true, padded = true, class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    'px-gutter',
    tone === 'red' ? 'bg-brick-red text-butter' : 'bg-butter',
    rule && 'border-t border-black',
    padded && 'py-section',
    className,
  ]}
  data-tone={tone}
  {...rest}
>
  <slot />
</Tag>
