---
/**
 * WhatWeDo — the "What we do" section on the home page (#services), in one of three versions
 * being compared:
 *
 *   cards      WhatWeDoCards: card with image + description beside the list (Figma 328:4782)
 *   lines      WhatWeDoLines: full-width lines, current one grows (Figma 337:5092)
 *   accordion  WhatWeDoAccordion: side-by-side strips, click one to open its card
 *
 * In dev and on the review deploy (the same switch as the font picker; see
 * ../dev/enabled.ts) all are rendered, and a "What we do" group in the font
 * picker's panel (the Aa button) swaps between them. The choice is remembered in this browser
 * and can be linked to with ?wwd=cards, ?wwd=lines or ?wwd=accordion. Production builds render
 * only the default (see ./wwd-versions.ts).
 */
import WhatWeDoCards from './WhatWeDoCards.astro';
import WhatWeDoLines from './WhatWeDoLines.astro';
import WhatWeDoAccordion from './WhatWeDoAccordion.astro';
import { fontPickerEnabled as review } from '../dev/enabled';
import type { Offering } from '../../data/site';
import { defaultWwdVersion, wwdVersions } from './wwd-versions';

interface Props {
  items: Offering[];
}

const { items } = Astro.props;

const versions = wwdVersions;
const defaultVersion = defaultWwdVersion;
---

{
  review ? (
    <>
      <script is:inline define:vars={{ defaultVersion, ids: versions.map((v) => v.id) }}>
        // Pick the version before the sections render, so the page doesn't jump.
        let wwd = new URLSearchParams(location.search).get('wwd');
        try {
          wwd ||= localStorage.getItem('cozm-wwd');
        } catch {}
        document.documentElement.dataset.wwd = ids.includes(wwd) ? wwd : defaultVersion;
      </script>
      <div data-wwd-version="cards">
        <WhatWeDoCards items={items} />
      </div>
      <div data-wwd-version="lines">
        <WhatWeDoLines items={items} />
      </div>
      <div data-wwd-version="accordion">
        <WhatWeDoAccordion items={items} />
      </div>
    </>
  ) : defaultVersion === 'cards' ? (
    <WhatWeDoCards items={items} />
  ) : defaultVersion === 'lines' ? (
    <WhatWeDoLines items={items} />
  ) : (
    <WhatWeDoAccordion items={items} />
  )
}

<style is:global>
  /* Only the chosen version shows (the inline script above sets data-wwd). */
  html:not([data-wwd='cards']) [data-wwd-version='cards'],
  html:not([data-wwd='lines']) [data-wwd-version='lines'],
  html:not([data-wwd='accordion']) [data-wwd-version='accordion'] {
    display: none;
  }
</style>

<script>
  // The switcher's radios are in the font picker's panel (FontPickerPanel),
  // hidden on pages without this section.
  const picker = document.querySelector<HTMLElement>('[data-wwd-picker]');
  const radios = [...document.querySelectorAll<HTMLInputElement>('[data-wwd-switch]')];
  const root = document.documentElement;

  if (picker && radios.length) {
    picker.hidden = false;
    radios.forEach((radio) => (radio.checked = radio.value === root.dataset.wwd));
    radios.forEach((radio) =>
      radio.addEventListener('change', () => {
        const version = radio.value;
        root.dataset.wwd = version;
        try {
          localStorage.setItem('cozm-wwd', version);
        } catch {
          // Storage blocked: the choice just isn't remembered.
        }
        const url = new URL(location.href);
        url.searchParams.set('wwd', version);
        history.replaceState(history.state, '', url);
        // The page height changed: re-measure the scroll effects and the header tone.
        window.dispatchEvent(new Event('resize'));
      }),
    );
  }
</script>
