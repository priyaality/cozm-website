---
/**
 * DayDial — the approach page's 90-day dial: a large ticked wheel on the left,
 * the day numeral just inside it, and that phase's step to the right.
 *
 * Scroll behaviour: the section pins for one viewport while the page scrolls
 * through it. Each SEGMENT of scroll turns the wheel 90° and moves on to the
 * next phase (day 01 → 30 → 60 → 90). A phase's text is shown only while the
 * wheel is at (or near) its 90° mark. When scrolling stops between marks the
 * page glides to the nearest one, so the wheel always comes to rest snapped.
 * After the last phase the section unpins and the page carries on.
 *
 * Desktop uses a 5/7 split of the page grid: the wheel's outer edge sits on
 * column 5's right edge, and the step copy starts on column 6. The 900px
 * circle is centred on the viewport-tall stage and spills into the sections
 * above and below.
 *
 * Without JS, or with prefers-reduced-motion, the wheel stays still and the
 * four phases are listed one after another.
 */
import dial from '../../assets/approach/dial.svg';
import type { ApproachStep } from '../../data/site';

interface Props {
  steps: ApproachStep[];
  /** Scroll distance for each 90° turn, as a CSS length. */
  segment?: string;
}

const { steps, segment = '80svh' } = Astro.props;
/** Two-column template shared by the wheel layer and every phase, so they line up. */
const cols = 'grid grid-cols-[5rem_minmax(0,1fr)] gap-x-column-gap lg:grid-12';
---

<section
  data-day-dial
  class="day-dial relative bg-sand px-gutter"
  style={`--dial-turns: ${steps.length - 1}; --dial-segment: ${segment}`}
>
  <div class="day-dial__stage relative">
    <!-- Wheel: its right edge on the first column's right edge (column 5 on desktop) -->
    <div class:list={[cols, 'pointer-events-none absolute inset-0']} aria-hidden="true">
      <div class="relative lg:col-span-5">
        <div class="absolute top-1/2 right-0 size-[560px] -translate-y-1/2 lg:size-[900px]">
          <img
            data-dial-wheel
            src={dial.src}
            width={dial.width}
            height={dial.height}
            alt=""
            class="size-full max-w-none will-change-transform"
          />
        </div>
      </div>
    </div>

    <ol class="day-dial__phases relative">
      {
        steps.map((step) => (
          <li data-dial-phase class:list={[cols, 'day-dial__phase items-center']}>
            <p class="flex flex-col justify-self-end pr-6 lg:col-span-5 lg:w-[calc(102px+2.5rem)] lg:pr-10">
              <span class="text-nav font-semibold text-ink-muted">DAY</span>
              <span class="text-right text-display-sm">{step.day}</span>
            </p>
            <div class="flex flex-col gap-1 lg:col-span-7">
              <h2 class="text-title">{step.title}</h2>
              <p class="max-w-[322px] text-body text-ink-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Fallback (no JS / reduced motion): phases listed down a viewport-tall section. */
  .day-dial__stage {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--spacing-section);
  }
  .day-dial__phases {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    width: 100%;
  }

  /* Pinned: the section is one viewport plus a segment per turn; the stage sticks
     while the page scrolls through it, and the phases sit on top of each other. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .day-dial {
      height: calc(100svh + var(--dial-turns) * var(--dial-segment));
    }
    :global(html.js) .day-dial__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      padding-block: 0;
    }
    :global(html.js) .day-dial__phases {
      display: grid;
    }
    :global(html.js) .day-dial__phase {
      grid-area: 1 / 1;
    }
    /* Before the script runs, show only the first phase. */
    :global(html.js) .day-dial__phase:not(:first-child) {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script>
  import { scroll } from 'motion';

  /** How far either side of a 90° mark (in turns) a phase stays fully visible, and where it has fully faded. */
  const HOLD = 0.15;
  const FADE_OUT = 0.45;
  /** How far (px) the text drifts as it fades in or out. */
  const DRIFT = 32;
  /** Rotation per phase. Negative = anticlockwise, so the visible right-hand edge moves up as you scroll down. */
  const TURN_DEG = -90;

  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  document.querySelectorAll<HTMLElement>('[data-day-dial]').forEach((root) => {
    const wheel = root.querySelector<HTMLElement>('[data-dial-wheel]')!;
    const phases = [...root.querySelectorAll<HTMLElement>('[data-dial-phase]')];
    const turns = phases.length - 1;
    let cancel: VoidFunction | undefined;

    /** t = 0 … turns: how far through the phases we are (1 = second phase, at 90°). */
    const render = (t: number) => {
      wheel.style.transform = `rotate(${t * TURN_DEG}deg)`;
      phases.forEach((phase, i) => {
        const offset = t - i;
        const opacity = clamp((FADE_OUT - Math.abs(offset)) / (FADE_OUT - HOLD), 0, 1);
        phase.style.opacity = String(opacity);
        phase.style.visibility = opacity > 0 ? 'visible' : 'hidden';
        phase.style.transform = `translateY(${clamp(-offset / FADE_OUT, -1, 1) * DRIFT}px)`;
        phase.toggleAttribute('inert', opacity < 0.5);
      });
    };

    /** Page position of the section, and how far it scrolls while pinned. */
    const metrics = () => {
      const top = root.getBoundingClientRect().top + window.scrollY;
      return { top, range: root.offsetHeight - window.innerHeight };
    };

    /** When scrolling stops between two marks, glide to the nearest one. */
    const snap = () => {
      if (!cancel) return;
      const { top, range } = metrics();
      if (range <= 0) return;
      const t = ((window.scrollY - top) / range) * turns;
      // Only while pinned: before the first mark or after the last, scroll is free.
      if (t <= 0 || t >= turns) return;
      const target = Math.round(t);
      if (Math.abs(t - target) < 0.005) return;
      window.scrollTo({ top: top + (target / turns) * range, behavior: 'smooth' });
    };

    const setup = () => {
      cancel?.();
      cancel = undefined;
      if (!motionOK.matches) {
        wheel.style.transform = '';
        phases.forEach((phase) => {
          phase.style.cssText = '';
          phase.removeAttribute('inert');
        });
        return;
      }
      cancel = scroll((progress: number) => render(progress * turns), {
        target: root,
        offset: ['start start', 'end end'],
      });
    };

    const supportsScrollEnd = 'onscrollend' in window;
    if (supportsScrollEnd) {
      window.addEventListener('scrollend', snap);
    } else {
      // Safari: treat a short pause in scroll events as the end of scrolling.
      let timer: number | undefined;
      window.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = window.setTimeout(snap, 150);
      }, { passive: true });
    }
    motionOK.addEventListener('change', setup);
    setup();
  });
</script>
