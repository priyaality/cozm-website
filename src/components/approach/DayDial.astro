---
/**
 * DayDial — the approach page's 90-day dial: a large ticked wheel on the left,
 * the day numeral just inside it, and that phase's step to the right.
 *
 * Scroll behaviour: the section pins for one viewport while the page scrolls
 * through it. Each `segment` of scroll turns the wheel 90°, and the day counter
 * counts along with it: 01 → 30 over the first turn, 30 → 60, then 60 → 90.
 * The step text follows the day: days 1–29 show phase 1, 30–59 phase 2,
 * 60–89 phase 3 and day 90 phase 4, crossfading in place as each starts.
 * After day 90 the section unpins and the page carries on.
 *
 * Desktop uses a 5/7 split of the page grid: the wheel's outer edge sits on
 * column 5's right edge, and the step copy starts on column 6. The 900px
 * circle is centred on the viewport-tall stage and spills into the sections
 * above and below.
 *
 * Without JS, or with prefers-reduced-motion, the wheel stays still and the
 * four phases are listed one after another.
 */
import dial from '../../assets/approach/dial.svg';
import type { ApproachStep } from '../../data/site';

interface Props {
  steps: ApproachStep[];
  /** Scroll distance for each 90° turn, as a CSS length. */
  segment?: string;
}

const { steps, segment = '80svh' } = Astro.props;
/** Two-column template shared by the wheel layer and every phase, so they line up. */
const cols = 'grid grid-cols-[5rem_minmax(0,1fr)] gap-x-column-gap lg:grid-12';
/** The "DAY / 01" block: right-aligned in the first column, just inside the wheel. */
const dayClass = 'flex flex-col justify-self-end pr-6 lg:col-span-5 lg:w-[calc(102px+2.5rem)] lg:pr-10';
---

<section
  data-day-dial
  class="day-dial relative bg-butter px-gutter"
  style={`--dial-turns: ${steps.length - 1}; --dial-segment: ${segment}`}
>
  <div class="day-dial__stage relative">
    <!-- Wheel: its right edge on the first column's right edge (column 5 on desktop) -->
    <div class:list={[cols, 'pointer-events-none absolute inset-0']} aria-hidden="true">
      <div class="relative lg:col-span-5">
        <div class="day-dial__wheel absolute top-1/2 right-0 size-[560px] -translate-y-1/2">
          <img
            data-dial-wheel
            src={dial.src}
            width={dial.width}
            height={dial.height}
            alt=""
            loading="lazy"
            decoding="async"
            class="size-full max-w-none will-change-transform"
          />
        </div>
      </div>
    </div>

    <!-- Live day counter (pinned mode only): counts up 01 → 90 as the wheel turns.
         Screen readers get each phase's own day below instead. -->
    <div class:list={[cols, 'day-dial__counter pointer-events-none absolute inset-0 items-center']} aria-hidden="true">
      <p class={dayClass}>
        <span class="text-nav font-semibold text-black-muted">DAY</span>
        <span data-dial-day class="text-right text-display tabular-nums">{steps[0].day}</span>
      </p>
    </div>

    <ol class="day-dial__phases relative">
      {
        steps.map((step, i) => (
          <li data-dial-phase data-day={Number(step.day)} data-current={i === 0 ? '' : undefined} class:list={[cols, 'day-dial__phase items-center']}>
            <p class:list={[dayClass, 'day-dial__day']}>
              <span class="text-nav font-semibold text-black-muted">DAY</span>
              <span class="text-right text-display">{step.day}</span>
            </p>
            <div class="flex flex-col gap-1 lg:col-span-7">
              <h2 class="text-title">{step.title}</h2>
              <p class="max-w-[322px] text-body text-black-muted">{step.description}</p>
              <p class="max-w-[322px] text-body text-brick-red italic">{step.agency}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Desktop wheel: Figma's proportion (a 900px circle in an 800px section), scaled
     to the visible height below the fixed header, so it always overflows by the
     same amount top and bottom. */
  @media (width >= 64rem) {
    .day-dial__wheel {
      width: calc((100svh - var(--spacing-nav)) * 1.125);
      height: calc((100svh - var(--spacing-nav)) * 1.125);
    }
  }

  /* Fallback (no JS / reduced motion): phases listed down a viewport-tall section. */
  .day-dial__stage {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--spacing-section);
  }
  .day-dial__phases {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    width: 100%;
  }

  /* Pinned: the stage sticks just below the fixed header and fills the rest of
     the viewport (so the wheel and text are centred in what's visible). The
     section is that tall plus a segment per turn. Phases sit on top of each other. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .day-dial {
      height: calc(100svh - var(--spacing-nav) + var(--dial-turns) * var(--dial-segment));
    }
    :global(html.js) .day-dial__stage {
      position: sticky;
      top: var(--spacing-nav);
      height: calc(100svh - var(--spacing-nav));
      min-height: 0;
      padding-block: 0;
    }
    :global(html.js) .day-dial__phases {
      display: grid;
    }
    /* Only the current phase's text shows; switching phases crossfades in place. */
    :global(html.js) .day-dial__phase {
      grid-area: 1 / 1;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.4s ease,
        visibility 0.4s;
    }
    :global(html.js) .day-dial__phase[data-current] {
      opacity: 1;
      visibility: visible;
    }
    /* The shared counter replaces each phase's own (static) day numeral. Opacity,
       not visibility, so screen readers still read each phase's day. */
    :global(html.js) .day-dial__counter {
      display: grid;
    }
    :global(html.js) .day-dial__day {
      opacity: 0;
    }
  }

  .day-dial__counter {
    display: none;
  }
</style>

<script>
  import { trackScrollProgress } from '../../scripts/scroll-progress';

  /** Rotation per phase. Negative = anticlockwise, so the visible right-hand edge moves up as you scroll down. */
  const TURN_DEG = -90;

  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)');

  document.querySelectorAll<HTMLElement>('[data-day-dial]').forEach((root) => {
    const wheel = root.querySelector<HTMLElement>('[data-dial-wheel]');
    const stage = root.querySelector<HTMLElement>('.day-dial__stage');
    const counter = root.querySelector<HTMLElement>('[data-dial-day]');
    const phases = [...root.querySelectorAll<HTMLElement>('[data-dial-phase]')];
    if (!wheel || !stage || !counter || phases.length < 2) return;
    /** The day each phase starts on (1, 30, 60, 90); the wheel is at that phase's 90° mark on that day. */
    const marks = phases.map((phase) => Number(phase.dataset.day));
    const turns = phases.length - 1;
    let cancel: VoidFunction | undefined;
    let current = 0;

    const setCurrent = (index: number) => {
      if (index === current) return;
      phases[current].removeAttribute('data-current');
      phases[current].inert = true;
      phases[index].setAttribute('data-current', '');
      phases[index].inert = false;
      current = index;
    };

    /** t = 0 … turns: how far the wheel has turned, in quarter turns (1 = 90°, day 30). */
    const render = (t: number) => {
      wheel.style.transform = `rotate(${t * TURN_DEG}deg)`;

      // Day: counts evenly between the marks (1 → 30 over the first turn, 30 → 60 …).
      const k = Math.min(Math.floor(t), turns - 1);
      const day = Math.floor(marks[k] + (marks[k + 1] - marks[k]) * (t - k) + 1e-6);
      counter.textContent = String(day).padStart(2, '0');

      // Text: the last phase whose start day has been reached.
      let index = 0;
      marks.forEach((mark, i) => {
        if (day >= mark) index = i;
      });
      setCurrent(index);
    };

    const setup = () => {
      cancel?.();
      cancel = undefined;
      if (!motionOK.matches) {
        // Static list: every phase readable, wheel at rest.
        wheel.style.transform = '';
        phases.forEach((phase) => (phase.inert = false));
        return;
      }
      phases.forEach((phase, i) => (phase.inert = i !== current));
      // Turning starts when the section's top reaches the bottom of the fixed header
      // (where the stage pins: its sticky `top`) and ends when the section unpins.
      const header = parseFloat(getComputedStyle(stage).top) || 0;
      cancel = trackScrollProgress(
        root,
        [
          [0, header / window.innerHeight],
          [1, 1],
        ],
        (progress) => render(progress * turns),
      );
    };

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 150);
    });
    motionOK.addEventListener('change', setup);
    setup();
  });
</script>
