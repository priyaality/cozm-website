---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import OriginalsShowcase from '../components/originals/OriginalsShowcase.astro';
import Footer from '../components/Footer.astro';
import { originals } from '../data/site';
---

<BaseLayout
  title="Cozm Originals: the shows we bet on ourselves"
  description="Cozm Originals are the shows we bet on ourselves, like All Risk is Creative, hosted by Palash Kulkarni, on people who bet everything on an idea."
>
  <Header />

  <main id="main-content">
    <OriginalsShowcase
      heading="Cozm Originals"
      accent="are the shows we bet on ourselves."
      items={originals}
    />
  </main>

  <Footer heading="Let’s talk about what your team could be making" accent="90 days from now." rule="red" />
</BaseLayout>
