---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import WorkAccordion from '../components/work/WorkAccordion.astro';
import Footer from '../components/Footer.astro';
import { workProjects } from '../data/site';
---

<BaseLayout
  title="Work: podcasts and documentaries for brands — Cozm"
  description="Shows we’ve made with brands: Uncovered with Suketu Shah, CapMint Stories, How I Masaba and PaisaSmart, with millions of views for India’s most demanding audience."
>
  <Header />

  <main id="main-content">
    <!-- Title (Figma 425:6359) -->
    <Section rule={false} padded={false} class="pt-[calc(var(--spacing-nav)+5rem)] pb-8">
      <h1 class="text-display">Made for India’s most demanding audience.</h1>
    </Section>

    <WorkAccordion projects={workProjects} />
  </main>

  <Footer />
</BaseLayout>
