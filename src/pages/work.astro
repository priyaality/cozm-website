---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import WorkShowcase from '../components/work/WorkShowcase.astro';
import Footer from '../components/Footer.astro';
import { workProjects } from '../data/site';
---

<BaseLayout
  title="Work: podcasts and documentaries for brands — Cozm"
  description="Shows we’ve made with brands: Uncovered with Suketu Shah, CapMint Stories, How I Masaba and PaisaSmart, with millions of views for India’s most demanding audience."
>
  <Header />

  <main id="main-content">
    <WorkShowcase heading="Made for India’s most demanding audience." projects={workProjects} />
  </main>

  <Footer />
</BaseLayout>
