---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import HeroVideo from '../components/HeroVideo.astro';
import ServicesTicker from '../components/ServicesTicker.astro';
import ScrollWordReveal from '../components/ScrollWordReveal.astro';
import MediaFeature from '../components/MediaFeature.astro';
import ScriptPage from '../components/script/ScriptPage.astro';
import WorkRow from '../components/WorkRow.astro';
import Footer from '../components/Footer.astro';
import { contactHref, featuredWork, heroVideo, services, statement } from '../data/site';

const [uncovered, capmint, paisasmart, masaba] = featuredWork;
---

<BaseLayout>
  <Header />

  <HeroVideo {...heroVideo} />

  <main>
    <!-- Intro + services ticker together fill one viewport -->
    <div class="flex min-h-svh flex-col">
      <Section rule class="grid-split flex-1 items-start gap-y-4 pt-[calc(var(--spacing-nav)+2.5rem)]">
        <h1 class="text-display">
          Cozm is a media studio that helps brands build original media for India’s top 10%.
        </h1>
        <div class="flex flex-col gap-6 lg:pt-5">
          <p class="text-body">
            We spend 90 days building it with your team, from the format to the launch, and leave you
            with everything you need to keep making it yourselves.
          </p>
          <div class="flex flex-col gap-4">
            <Button href={contactHref} variant="primary">Talk to us</Button>
            <Button href="/approach" variant="secondary">Learn our approach</Button>
          </div>
        </div>
      </Section>

      <ServicesTicker items={services} />
    </div>

    <!-- Statement: words reveal on scroll -->
    <ScrollWordReveal paragraphs={statement} />

    <!-- Originals -->
    <Section rule={false} padded={false} class="flex flex-col gap-10 pb-10">
      <MediaFeature
        title="All Risk is creative"
        description="We spend 90 days building it with your team, from the format to the launch, and leave you with everything you need to keep making it yourselves."
        cta={{ label: 'Listen on Spotify', href: '#' }}
      />
      <MediaFeature
        title="The Craft"
        description="We spend 90 days building it with your team, from the format to the launch, and leave you with everything you need to keep making it yourselves."
        cta={{ label: 'Watch on YouTube', href: '#' }}
      />
    </Section>

    <!-- Approach -->
    <Section class="grid-split items-start gap-y-12">
      <div>
        <ScriptPage />
      </div>
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <h2 class="text-headline">Our job is to get your team to a point where they don’t need us.</h2>
          <p class="text-body text-ink-muted">
            Here’s how the usual agency script goes, and how we’d rewrite it.
          </p>
        </div>
        <Button href="/approach" variant="secondary">Read the full approach</Button>
      </div>
    </Section>

    <!-- Featured work -->
    <section aria-labelledby="featured-work">
      <Section padded={false} class="pt-16 pb-[23px]">
        <div class="grid-split items-end gap-y-6">
          <h2 id="featured-work" class="text-headline">Featured work</h2>
          <Button href="/work" variant="secondary">View all work</Button>
        </div>
      </Section>
      <WorkRow items={[uncovered, capmint]} />
      <WorkRow items={[paisasmart, masaba]} reverse />
    </section>
  </main>

  <Footer />
</BaseLayout>
