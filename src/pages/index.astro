---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Ticker from '../components/Ticker.astro';
import MediaFeature from '../components/MediaFeature.astro';
import ScriptPage from '../components/script/ScriptPage.astro';
import WorkRow from '../components/WorkRow.astro';
import Footer from '../components/Footer.astro';
import { contactHref, featuredWork, services } from '../data/site';

const [uncovered, capmint, paisasmart, masaba] = featuredWork;
---

<BaseLayout>
  <!-- Hero media (black placeholder in Figma; video/image goes here) -->
  <div class="relative h-[70svh] min-h-[480px] bg-black lg:h-[805px]">
    <Header />
  </div>

  <main>
    <!-- Intro -->
    <Section rule class="grid-split items-start">
      <h1 class="text-display">
        Cozm is a media studio that helps brands build original media for India’s top 10%.
      </h1>
      <div class="flex flex-col gap-6 lg:pt-5">
        <p class="text-body">
          We spend 90 days building it with your team, from the format to the launch, and leave you
          with everything you need to keep making it yourselves.
        </p>
        <div class="flex flex-col gap-4">
          <Button href={contactHref} variant="primary">Talk to us</Button>
          <Button href="/approach" variant="secondary">Learn our approach</Button>
        </div>
      </div>
    </Section>

    <Ticker items={services} />

    <!-- Statement -->
    <Section class="text-statement">
      <p class="mb-10">India’s most curious audience has plenty to watch, just very little about India.</p>
      <p class="mb-10 text-ink-faint">
        <span class="text-ink">
          India’s top 10% is about 140 million people, curious, ambitious and hungry for media that
          makes them think. But Indian media has
        </span>{' '}
        mostly aimed for the widest audience, leaving them to fill the gap with shows from elsewhere.
      </p>
      <p class="text-ink-faint">
        We think they deserve better, so we started making it ourselves. Our originals are where we
        learn what this audience chooses, and everything we build with brands starts from there.
      </p>
    </Section>

    <!-- Originals -->
    <Section rule={false} padded={false} class="flex flex-col gap-10 pb-10">
      <MediaFeature
        title="All Risk is creative"
        description="We spend 90 days building it with your team, from the format to the launch, and leave you with everything you need to keep making it yourselves."
        cta={{ label: 'Listen on Spotify', href: '#' }}
      />
      <MediaFeature
        title="The Craft"
        description="We spend 90 days building it with your team, from the format to the launch, and leave you with everything you need to keep making it yourselves."
        cta={{ label: 'Watch on YouTube', href: '#' }}
      />
    </Section>

    <!-- Approach -->
    <Section class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-4">
      <div class="lg:flex-1">
        <ScriptPage />
      </div>
      <div class="flex flex-col gap-6 lg:w-aside lg:shrink-0">
        <div class="flex flex-col gap-2">
          <h2 class="text-headline">Our job is to get your team to a point where they don’t need us.</h2>
          <p class="text-body text-ink-muted">
            Here’s how the usual agency script goes, and how we’d rewrite it.
          </p>
        </div>
        <Button href="/approach" variant="secondary">Read the full approach</Button>
      </div>
    </Section>

    <!-- Featured work -->
    <section aria-labelledby="featured-work">
      <Section padded={false} class="pt-16 pb-[23px]">
        <div class="grid-split items-end gap-6">
          <h2 id="featured-work" class="text-headline">Featured work</h2>
          <Button href="/work" variant="secondary">View all work</Button>
        </div>
      </Section>
      <WorkRow items={[uncovered, capmint]} />
      <WorkRow items={[paisasmart, masaba]} reverse />
    </section>
  </main>

  <Footer />
</BaseLayout>
