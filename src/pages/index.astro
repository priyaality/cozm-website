---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import HeroPlayer from '../components/hero/HeroPlayer.astro';
import LogoTicker from '../components/LogoTicker.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import ScriptPage from '../components/script/ScriptPage.astro';
import Footer from '../components/Footer.astro';
import { heroVideo } from '../data/site';
---

<BaseLayout
  title="Cozm — Original media for India’s top 10%"
  description="Cozm is a media studio that helps brands build original media for India’s top 10%: podcasts, documentaries and video essays, made with your team in 90 days."
>
  <!-- The hero poster is the first thing painted in the player card. -->
  {heroVideo.poster && <link slot="head" rel="preload" as="image" href={heroVideo.poster} fetchpriority="high" />}

  <Header />

  <main>
    <!-- Curtain: the hero stays pinned while the intro slides up over it. The
         wrapper ends with the intro, so the hero unpins once it's fully covered. -->
    <div data-curtain class="relative">
      <!-- Where the hero would scroll in normal flow. The header watches this
           (not the pinned hero) to know when the intro has reached the top. -->
      <div data-hero-area aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-svh"></div>
      <div class="sticky top-0">
        <HeroPlayer {...heroVideo} next="main-content" />
      </div>

      <!-- Intro + client logos fill one viewport together -->
      <div id="main-content" class="relative z-10 flex min-h-svh flex-col">
        <Section tone="red" class="grid-split flex-1 items-start gap-y-4 pt-[calc(var(--spacing-nav)+2.5rem)]">
          <!-- Desktop: the heading also shrinks on short screens, so the intro and the
               logo ticker fit one screen. Taken off the screen height: the header, 276px
               (40 above the heading + 80 bottom padding + ticker 155 + the 1px rule); the
               rest is shared by ~5 lines of heading. -->
          <h1 class="text-display lg:text-[length:min(var(--text-display),calc((100svh-var(--spacing-nav)-276px)/5))]">
            Cozm is a media studio that helps brands build{' '}
            <span class="text-black">original media for India’s top 10%.</span>
          </h1>
          <div class="flex flex-col gap-6 lg:pt-5">
            <div class="flex flex-col gap-6">
              <p class="text-body">
                We spend 90 days building it with your team, from the format to the launch, and leave you
                with everything you need to keep making it yourselves.
              </p>
              <p class="text-body">
                We spend 90 days building it with your team, from the format to the launch, and leave you
                with everything you need to keep making it yourselves.
              </p>
            </div>
            <div class="flex flex-col gap-4">
              <Button href="/approach" variant="secondary">Learn our approach</Button>
            </div>
          </div>
        </Section>

        <!-- Client logos ("Built with") -->
        <LogoTicker />
      </div>
    </div>

    <!-- Featured work: heading + "View all work", then scroll sideways through the cards -->
    <FeaturedWork />

    <!-- Approach -->
    <Section tone="red" class="grid-split items-start gap-y-12">
      <div>
        <ScriptPage />
      </div>
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <h2 class="text-headline">Our job is to get your team to a point where they don’t need us.</h2>
          <p class="text-body">
            Here’s how the usual agency script goes, and how we’d rewrite it.
          </p>
        </div>
        <Button href="/approach" variant="outline">Learn our approach</Button>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>

<script>
  /**
   * Curtain snap: the intro never rests partway over the hero.
   *
   * Down (hero → intro): as soon as the visitor starts scrolling, we take over
   * and glide the intro to the top, easing out so it lands softly.
   * Up (intro → hero) has some resistance: the page scrolls normally for the
   * first UP_THRESHOLD px, and only past that do we glide back to the hero.
   * Stopping short of it settles the intro back at the top.
   * Leftover trackpad momentum after a glide is swallowed, so it can't
   * overshoot. Momentum is a fast stream of shrinking wheel deltas, so after
   * the glide only that is swallowed: a delta that doesn't shrink (a mouse
   * wheel's steady ticks, a new swipe) or comes after a pause is a new scroll
   * and goes through, e.g. to carry on down past the intro. During the glide,
   * input in its direction is swallowed. Scrolling the other way (during the
   * glide or just after) stops it and is handled like any other scroll.
   * When input goes quiet with the page stopped partway
   * (a short scroll up, keys, the scrollbar), the same rules finish the move.
   */
  import { cubicBezier, glideScroll } from '../scripts/glide-scroll';

  const intro = document.getElementById('main-content');
  const root = document.documentElement;

  if (intro && document.querySelector('[data-curtain]')) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /** Scroll position with the intro at the top (the hero's height), measured fresh. */
    const end = () => intro.getBoundingClientRect().top + window.scrollY;
    /** How far up (px) the visitor must scroll from the intro before it glides back to the hero. */
    const upThreshold = () => Math.min(200, window.innerHeight * 0.2);
    // The hero's loading intro locks scrolling; don't move the page during it.
    const unlocked = () => !root.querySelector('[data-hero-player]') || root.classList.contains('hero-intro-done');

    // ease-out: picks up the visitor's motion, lands softly
    const easeOut = cubicBezier(0.22, 1, 0.36, 1);

    let gliding = false;
    let quietTimer: number | undefined;
    /** True from the start of a glide until input has been quiet for a moment after it. */
    let swallowing = false;
    /** Direction of the current / last glide (1 down, -1 up); only this direction is swallowed. */
    let glideDirection = 0;
    /** The previous wheel event's size and time, to tell momentum from a new scroll. */
    let lastSize = 0;
    let lastAt = 0;
    /** Momentum: within 80ms of the last event and smaller than it (or a tiny tail value). */
    const isMomentum = (size: number, at: number) => at - lastAt < 80 && (size < lastSize || size <= 2);
    let stopGlide: (() => void) | undefined;

    /** Drop the current glide (if any) and stop swallowing, e.g. when the visitor reverses. */
    const release = () => {
      stopGlide?.();
      stopGlide = undefined;
      clearTimeout(quietTimer);
      gliding = swallowing = false;
    };

    const keepSwallowing = () => {
      clearTimeout(quietTimer);
      quietTimer = window.setTimeout(() => {
        if (!gliding) swallowing = false;
      }, 200);
    };

    const glide = (direction: number) => {
      const target = direction > 0 ? end() : 0;
      if (Math.abs(window.scrollY - target) < 1) return;
      stopGlide?.();
      gliding = swallowing = true;
      glideDirection = direction;
      const done = () => {
        gliding = false;
        stopGlide = undefined;
        keepSwallowing();
      };
      if (reducedMotion) {
        window.scrollTo({ top: target, behavior: 'instant' });
        done();
        return;
      }
      stopGlide = glideScroll(target, 900, easeOut, done);
    };

    /** Should a scroll in this direction be turned into a glide? */
    const inCurtain = (direction: number) => {
      const y = window.scrollY;
      const e = end();
      // Up: only once the visitor has scrolled past the threshold; before that, scroll normally.
      return direction > 0 ? y < e - 1 : y > 0 && y <= e - upThreshold();
    };

    /** size: the wheel delta's magnitude (Infinity for touch, which has no momentum events). */
    const intent = (event: Event, direction: number, size = Infinity) => {
      if (!unlocked() || direction === 0) return;
      const at = performance.now();
      const momentum = isMomentum(size, at);
      lastSize = size;
      lastAt = at;
      if (swallowing) {
        if (direction === glideDirection && (gliding || momentum)) {
          // Already moving that way, or momentum from the gesture that started the glide.
          event.preventDefault();
          keepSwallowing();
          return;
        }
        // Scrolling the other way, or a new scroll after the glide: not momentum.
        release();
      }
      if (inCurtain(direction)) {
        event.preventDefault();
        glide(direction);
      }
    };

    window.addEventListener('wheel', (e) => intent(e, Math.sign(e.deltaY), Math.abs(e.deltaY)), { passive: false });

    let touchY = 0;
    window.addEventListener('touchstart', (e) => (touchY = e.touches[0].clientY), { passive: true });
    window.addEventListener(
      'touchmove',
      (e) => {
        const dy = touchY - e.touches[0].clientY;
        if (Math.abs(dy) > 8 || swallowing) intent(e, Math.sign(dy));
      },
      { passive: false },
    );

    // When all input has been quiet for a moment (no wheel, scroll or finger on
    // the screen), finish a move that stopped partway. Not `scrollend`: Chrome
    // fires it after every wheel tick, mid-gesture.
    let lastY = window.scrollY;
    let direction = 0;
    let touching = false;
    let idleTimer: number | undefined;
    const settle = () => {
      if (gliding || touching || !unlocked()) return;
      const y = window.scrollY;
      const e = end();
      if (y <= 0 || y >= e - 1) return;
      // A short scroll up from the intro (not past the threshold) settles back on the intro.
      glide(direction < 0 && y <= e - upThreshold() ? -1 : 1);
    };
    const settleWhenQuiet = () => {
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(settle, 180);
    };
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (y !== lastY) direction = Math.sign(y - lastY);
        lastY = y;
        settleWhenQuiet();
      },
      { passive: true },
    );
    window.addEventListener('wheel', settleWhenQuiet, { passive: true });
    window.addEventListener('touchstart', () => (touching = true), { passive: true });
    window.addEventListener(
      'touchend',
      () => {
        touching = false;
        settleWhenQuiet();
      },
      { passive: true },
    );
  }
</script>
