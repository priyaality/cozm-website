---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import DayDial from '../components/approach/DayDial.astro';
import DayNinetyOne from '../components/approach/DayNinetyOne.astro';
import AgencyComparison from '../components/approach/AgencyComparison.astro';
import WhatWeDo from '../components/approach/WhatWeDo.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Footer from '../components/Footer.astro';
import { approachSteps, contactHref, dayNinetyOne, offerings } from '../data/site';
---

<BaseLayout>
  <Header />

  <!-- overflow-x-clip: the dial's circle runs off the left edge; clip (not hidden) so it can't scroll sideways. -->
  <main id="main-content" class="overflow-x-clip">
    <!-- Intro: full-width headline, then a 7/5 split of copy and CTA -->
    <Section
      rule={false}
      padded={false}
      class="flex flex-col gap-8 pt-[calc(var(--spacing-nav)+var(--spacing-section))] pb-[clamp(4rem,2.5rem+6vw,7.5rem)]"
    >
      <h1 class="text-display">
        Give us 90 days, and you’ll have your own media and a team that knows how to make it.
      </h1>
      <div class="grid-split items-center gap-y-6">
        <p class="text-body">
          Everything we do is meant to leave your team more capable, from the format and first
          episodes to the workflows that keep it going.
        </p>
        <Button href={contactHref} variant="primary">Start a conversation</Button>
      </div>
    </Section>

    <!-- The 90 days: 5/7 split around the dial -->
    <DayDial steps={approachSteps} />

    <!-- Day 91: what the team is left with -->
    <DayNinetyOne items={dayNinetyOne} />

    <!-- Typical agency vs Cozm -->
    <AgencyComparison />

    <!-- What we do: offerings as tabs with an image stack -->
    <WhatWeDo items={offerings} />

    <FeaturedWork />
  </main>

  <Footer heading="Let’s talk about what your team could be making 90 days from now." />
</BaseLayout>
