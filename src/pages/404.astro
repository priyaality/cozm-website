---
/**
 * 404 — served by the static host for unknown paths. Laid out like the
 * approach page's intro: display headline, then a 7/5 split of copy and CTAs.
 * Kept out of search results.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page not found — Cozm"
  description="This page doesn’t exist. Head back to Cozm, the media studio building original media with brands for India’s top 10%."
  noindex
>
  <Header />

  <main id="main-content">
    <Section
      rule={false}
      padded={false}
      class="flex flex-col gap-8 pt-[calc(var(--spacing-nav)+var(--spacing-section))] pb-[clamp(4rem,2.5rem+6vw,7.5rem)]"
    >
      <p class="button-text text-black-muted uppercase">404</p>
      <h1 class="text-display">This page isn’t here.</h1>
      <div class="grid-split items-center gap-y-6">
        <p class="text-body">
          The link may be old, or the page may have moved. Everything we make starts from the home
          page.
        </p>
        <div class="flex flex-col gap-4">
          <Button href="/" variant="primary">Back to home</Button>
          <Button href="/work" variant="secondary">See our work</Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>
