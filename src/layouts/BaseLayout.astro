---
import Fonts from '../components/head/Fonts.astro';
import Seo from '../components/head/Seo.astro';
import '../styles/global.css';
import FontPicker from '../components/dev/FontPicker.astro';
import CopyEmailOnClick from '../components/ui/CopyEmailOnClick.astro';
import { seo } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { title = seo.defaultTitle, description = seo.defaultDescription, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {noindex} />
    <!-- Lets CSS hide JS-animated elements before their intro, without hiding them when JS is off. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Fonts />
    <!-- Page-specific head tags, e.g. <link slot="head" rel="preload" …>. -->
    <slot name="head" />
  </head>
  <body class="bg-sand text-ink">
    <!-- Keyboard users: first Tab stop, shown only when focused. Every page has an element with id="main-content" (on home, the intro below the hero). -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:text-sand"
      >Skip to content</a
    >
    <slot />
    <CopyEmailOnClick />
    <FontPicker />
  </body>
</html>
