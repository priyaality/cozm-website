{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "overrides": [{ "files": ["*.css"], "options": { "singleQuote": false } }],
  "ignorePatterns": ["**/*.md", "bun.lock", "dist/**", ".astro/**", "public/**"]
}
